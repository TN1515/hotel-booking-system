@model HotelBooking.Models.ViewModels.StaffProfileViewModel
@{
    ViewData["Title"] = "Staff Profile";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="mb-1">
                        <i class="fas fa-user-tie text-primary me-2"></i>
                        Staff Profile
                    </h2>
                    <p class="text-muted mb-0">Welcome back, @Model.User?.UserName</p>
                </div>
                <div>
                    <a href="@Url.Action("Index", "Dashboard")" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
                    </a>
                </div>
            </div>

            <!-- Profile Information -->
            <div class="row mb-4">
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0">
                                <i class="fas fa-user me-2"></i>Profile Information
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="text-center mb-3">
                                <div class="avatar-circle bg-primary text-white mx-auto mb-3">
                                    <i class="fas fa-user-tie fa-2x"></i>
                                </div>
                                <h5 class="mb-1">@Model.User?.UserName</h5>
                                <p class="text-muted mb-0">Hotel Staff</p>
                            </div>

                            <hr>

                            <div class="row">
                                <div class="col-sm-6">
                                    <p class="mb-2"><strong>Email:</strong></p>
                                    <p class="text-muted">@Model.User?.Email</p>
                                </div>
                                <div class="col-sm-6">
                                    <p class="mb-2"><strong>Phone:</strong></p>
                                    <p class="text-muted">@(Model.User?.PhoneNumber ?? "Not provided")</p>
                                </div>
                                <div class="col-sm-6">
                                    <p class="mb-2"><strong>Status:</strong></p>
                                    <span class="badge bg-success">Active</span>
                                </div>
                                <div class="col-sm-6">
                                    <p class="mb-2"><strong>Joined:</strong></p>
                                    <p class="text-muted">@Model.User?.CreatedDate.ToString("MMM dd, yyyy")</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-8">
                    <!-- Statistics Cards -->
                    <div class="row mb-4">
                        <div class="col-md-3 mb-3">
                            <div class="card border-0 shadow-sm bg-primary text-white">
                                <div class="card-body text-center">
                                    <i class="fas fa-calendar-day fa-2x mb-2"></i>
                                    <h4 class="mb-1">@Model.TodayReservations</h4>
                                    <p class="mb-0 small">Today's Bookings</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="card border-0 shadow-sm bg-success text-white">
                                <div class="card-body text-center">
                                    <i class="fas fa-calendar-alt fa-2x mb-2"></i>
                                    <h4 class="mb-1">@Model.MonthlyReservations</h4>
                                    <p class="mb-0 small">This Month</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="card border-0 shadow-sm bg-warning text-white">
                                <div class="card-body text-center">
                                    <i class="fas fa-clock fa-2x mb-2"></i>
                                    <h4 class="mb-1">@Model.PendingReservations</h4>
                                    <p class="mb-0 small">Pending</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="card border-0 shadow-sm bg-info text-white">
                                <div class="card-body text-center">
                                    <i class="fas fa-dollar-sign fa-2x mb-2"></i>
                                    <h4 class="mb-1">@Model.TotalRevenue.ToString("C0")</h4>
                                    <p class="mb-0 small">Total Revenue</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Recent Activities -->
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">
                                <i class="fas fa-history me-2"></i>Recent Activities
                            </h5>
                        </div>
                        <div class="card-body">
                            @if (Model.RecentActivities.Any())
                            {
                                <div class="timeline">
                                    @foreach (var activity in Model.RecentActivities)
                                    {
                                        <div class="timeline-item">
                                            <div class="timeline-marker bg-primary"></div>
                                            <div class="timeline-content">
                                                <h6 class="mb-1">@activity.Description</h6>
                                                <p class="text-muted mb-0 small">
                                                    <i class="fas fa-clock me-1"></i>
                                                    @activity.Date.ToString("MMM dd, yyyy HH:mm")
                                                </p>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-4">
                                    <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                                    <p class="text-muted">No recent activities</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="row">
                <div class="col-12">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-dark text-white">
                            <h5 class="mb-0">
                                <i class="fas fa-bolt me-2"></i>Quick Actions
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-3 mb-3">
                                    <a href="@Url.Action("Index", "Dashboard")" class="btn btn-outline-primary w-100">
                                        <i class="fas fa-tachometer-alt me-2"></i>Dashboard
                                    </a>
                                </div>
                                <div class="col-md-3 mb-3">
                                    <a href="@Url.Action("Index", "Reservations")" class="btn btn-outline-success w-100">
                                        <i class="fas fa-calendar-check me-2"></i>Reservations
                                    </a>
                                </div>
                                <div class="col-md-3 mb-3">
                                    <a href="@Url.Action("Index", "GuestProfile")" class="btn btn-outline-info w-100">
                                        <i class="fas fa-users me-2"></i>Guests
                                    </a>
                                </div>
                                <div class="col-md-3 mb-3">
                                    <a href="@Url.Action("Index", "Report")" class="btn btn-outline-warning w-100">
                                        <i class="fas fa-chart-bar me-2"></i>Reports
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.avatar-circle {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
}

.timeline {
    position: relative;
    padding-left: 30px;
}

.timeline-item {
    position: relative;
    margin-bottom: 20px;
}

.timeline-marker {
    position: absolute;
    left: -35px;
    top: 5px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
}

.timeline-item:not(:last-child)::before {
    content: '';
    position: absolute;
    left: -31px;
    top: 15px;
    width: 2px;
    height: calc(100% + 10px);
    background-color: #dee2e6;
}

.card {
    border-radius: 12px;
}

.card-header {
    border-radius: 12px 12px 0 0 !important;
}

.btn {
    border-radius: 8px;
}
</style>
