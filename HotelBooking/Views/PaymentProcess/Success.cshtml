@model HotelBooking.Models.ViewModels.PaymentSuccessViewModel
@{
    ViewData["Title"] = "Payment Successful";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-success">
                <div class="card-header bg-success text-white text-center">
                    <div class="success-animation mb-3">
                        <i class="fas fa-check-circle fa-4x"></i>
                    </div>
                    <h2 class="mb-0">Payment Successful!</h2>
                    <p class="mb-0">Your payment has been processed successfully</p>
                </div>

                <div class="card-body">
                    <!-- Payment Summary -->
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <div class="card bg-light">
                                <div class="card-body">
                                    <h5 class="card-title text-primary">
                                        <i class="fas fa-receipt me-2"></i>Payment Details
                                    </h5>
                                    <div class="payment-details">
                                        <div class="detail-row">
                                            <span class="label">Transaction ID:</span>
                                            <span class="value">#@Model.TransactionId</span>
                                        </div>
                                        <div class="detail-row">
                                            <span class="label">Amount Paid:</span>
                                            <span class="value text-success fw-bold">@Model.Amount.ToString("C", new System.Globalization.CultureInfo("vi-VN"))</span>
                                        </div>
                                        <div class="detail-row">
                                            <span class="label">Payment Method:</span>
                                            <span class="value">@Model.PaymentMethod</span>
                                        </div>
                                        <div class="detail-row">
                                            <span class="label">Payment Date:</span>
                                            <span class="value">@Model.PaymentDate.ToString("dd/MM/yyyy HH:mm")</span>
                                        </div>
                                        <div class="detail-row">
                                            <span class="label">Status:</span>
                                            <span class="badge bg-success">@Model.Status</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="card bg-light">
                                <div class="card-body">
                                    <h5 class="card-title text-info">
                                        <i class="fas fa-bed me-2"></i>Booking Details
                                    </h5>
                                    <div class="booking-details">
                                        <div class="detail-row">
                                            <span class="label">Reservation ID:</span>
                                            <span class="value">#@Model.ReservationId</span>
                                        </div>
                                        <div class="detail-row">
                                            <span class="label">Guest Name:</span>
                                            <span class="value">@Model.GuestName</span>
                                        </div>
                                        <div class="detail-row">
                                            <span class="label">Room:</span>
                                            <span class="value">@Model.RoomNumber - @Model.RoomType</span>
                                        </div>
                                        <div class="detail-row">
                                            <span class="label">Check-in:</span>
                                            <span class="value">@Model.CheckInDate.ToString("dd/MM/yyyy")</span>
                                        </div>
                                        <div class="detail-row">
                                            <span class="label">Check-out:</span>
                                            <span class="value">@Model.CheckOutDate.ToString("dd/MM/yyyy")</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Next Steps -->
                    <div class="alert alert-info">
                        <h5 class="alert-heading">
                            <i class="fas fa-info-circle me-2"></i>What's Next?
                        </h5>
                        <div class="row">
                            <div class="col-md-4 text-center">
                                <i class="fas fa-envelope fa-2x text-primary mb-2"></i>
                                <h6>Email Confirmation</h6>
                                <p class="small mb-0">A confirmation email has been sent to your registered email address.</p>
                            </div>
                            <div class="col-md-4 text-center">
                                <i class="fas fa-mobile-alt fa-2x text-success mb-2"></i>
                                <h6>SMS Notification</h6>
                                <p class="small mb-0">You'll receive SMS updates about your booking status.</p>
                            </div>
                            <div class="col-md-4 text-center">
                                <i class="fas fa-calendar-check fa-2x text-warning mb-2"></i>
                                <h6>Check-in Ready</h6>
                                <p class="small mb-0">Your room will be ready for check-in on the scheduled date.</p>
                            </div>
                        </div>
                    </div>

                    <!-- Important Information -->
                    <div class="card border-warning mb-4">
                        <div class="card-header bg-warning text-dark">
                            <h6 class="mb-0">
                                <i class="fas fa-exclamation-triangle me-2"></i>Important Information
                            </h6>
                        </div>
                        <div class="card-body">
                            <ul class="mb-0">
                                <li>Please arrive at the hotel by <strong>@Model.CheckInDate.ToString("dd/MM/yyyy") 14:00</strong> for check-in</li>
                                <li>Bring a valid ID and this payment confirmation for verification</li>
                                <li>Check-out time is <strong>@Model.CheckOutDate.ToString("dd/MM/yyyy") 12:00</strong></li>
                                <li>For any changes or cancellations, contact us at least 24 hours in advance</li>
                                <li>Late check-out may incur additional charges</li>
                            </ul>
                        </div>
                    </div>

                    <!-- Contact Information -->
                    <div class="card border-primary mb-4">
                        <div class="card-header bg-primary text-white">
                            <h6 class="mb-0">
                                <i class="fas fa-phone me-2"></i>Need Assistance?
                            </h6>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-4 text-center">
                                    <i class="fas fa-phone fa-2x text-primary mb-2"></i>
                                    <h6>Phone</h6>
                                    <p class="mb-0">+84 123 456 789</p>
                                    <small class="text-muted">24/7 Support</small>
                                </div>
                                <div class="col-md-4 text-center">
                                    <i class="fas fa-envelope fa-2x text-info mb-2"></i>
                                    <h6>Email</h6>
                                    <p class="mb-0">support@hotel.com</p>
                                    <small class="text-muted">Response within 2 hours</small>
                                </div>
                                <div class="col-md-4 text-center">
                                    <i class="fas fa-comments fa-2x text-success mb-2"></i>
                                    <h6>Live Chat</h6>
                                    <p class="mb-0">Available on website</p>
                                    <small class="text-muted">9:00 AM - 10:00 PM</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="text-center">
                        <div class="btn-group" role="group">
                            <a href="@Url.Action("Details", "Reservations", new { id = Model.ReservationId })"
                               class="btn btn-primary btn-lg">
                                <i class="fas fa-eye me-2"></i>View Booking Details
                            </a>
                            <a href="@Url.Action("Index", "Reservations")"
                               class="btn btn-info btn-lg">
                                <i class="fas fa-list me-2"></i>My Bookings
                            </a>
                            <button type="button" class="btn btn-success btn-lg" onclick="printReceipt()">
                                <i class="fas fa-print me-2"></i>Print Receipt
                            </button>
                        </div>

                        <div class="mt-3">
                            <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary">
                                <i class="fas fa-home me-2"></i>Back to Home
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function printReceipt() {
            window.print();
        }

        // Auto-redirect after 30 seconds (optional)
        setTimeout(function() {
            if (confirm('Would you like to view your booking details?')) {
                window.location.href = '@Url.Action("Details", "Reservations", new { id = Model.ReservationId })';
            }
        }, 30000);
    </script>
}

<style>
    .success-animation {
        animation: bounce 1s ease-in-out;
    }

    @@keyframes bounce {
        0%, 20%, 50%, 80%, 100% {
            transform: translateY(0);
        }
        40% {
            transform: translateY(-10px);
        }
        60% {
            transform: translateY(-5px);
        }
    }

    .detail-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 8px 0;
        border-bottom: 1px solid #eee;
    }

    .detail-row:last-child {
        border-bottom: none;
    }

    .label {
        font-weight: 500;
        color: #6c757d;
    }

    .value {
        font-weight: 600;
        color: #212529;
    }

    .card {
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        transition: transform 0.2s;
    }

    .card:hover {
        transform: translateY(-2px);
    }

    .btn-group .btn {
        margin: 0 5px;
    }

    @@media print {
        .btn, .alert, .card-header {
            display: none !important;
        }

        .card {
            box-shadow: none;
            border: 1px solid #000;
        }

        .container {
            max-width: 100%;
        }
    }

    @@media (max-width: 768px) {
        .btn-group {
            flex-direction: column;
        }

        .btn-group .btn {
            margin: 5px 0;
            width: 100%;
        }
    }
</style>
