@model List<HotelBooking.Models.ViewModels.FeedbackManagementViewModel>
@{
    ViewData["Title"] = "Recent Customer Feedback";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="card-title">
                        <i class="fas fa-comments me-2"></i>Recent Customer Feedback
                    </h3>
                    <div class="card-tools">
                        <a href="@Url.Action("Index")" class="btn btn-primary">
                            <i class="fas fa-list me-2"></i>View All Feedback
                        </a>
                        <a href="@Url.Action("Statistics")" class="btn btn-info">
                            <i class="fas fa-chart-line me-2"></i>Statistics
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    @if (Model != null && Model.Any())
                    {
                        <div class="row">
                            @foreach (var feedback in Model)
                            {
                                <div class="col-lg-6 col-xl-4 mb-4">
                                    <div class="card h-100 @(feedback.Rating >= 4 ? "border-success" : feedback.Rating >= 3 ? "border-warning" : "border-danger")">
                                        <div class="card-header bg-light">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <div>
                                                    <strong class="text-primary">@feedback.GuestName</strong>
                                                    <br>
                                                    <small class="text-muted">@feedback.GuestEmail</small>
                                                </div>
                                                <div class="text-end">
                                                    <div class="rating mb-1">
                                                        @for (int i = 1; i <= 5; i++)
                                                        {
                                                            <i class="fas fa-star @(i <= feedback.Rating ? "text-warning" : "text-muted")"></i>
                                                        }
                                                    </div>
                                                    <small class="text-muted">@feedback.FeedbackDate.ToString("dd/MM/yyyy HH:mm")</small>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="card-body">
                                            <p class="card-text">
                                                "@feedback.Comment"
                                            </p>
                                            
                                            @if (feedback.RoomNumber != "General")
                                            {
                                                <div class="mt-3 p-2 bg-light rounded">
                                                    <small class="text-muted">
                                                        <i class="fas fa-bed me-1"></i>
                                                        <strong>Room:</strong> @feedback.RoomNumber (@feedback.RoomType)
                                                        @if (feedback.CheckInDate != DateTime.MinValue)
                                                        {
                                                            <br>
                                                            <i class="fas fa-calendar me-1"></i>
                                                            <strong>Stay:</strong> @feedback.CheckInDate.ToString("dd/MM") - @feedback.CheckOutDate.ToString("dd/MM/yyyy")
                                                        }
                                                    </small>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="mt-3 p-2 bg-info bg-opacity-10 rounded">
                                                    <small class="text-info">
                                                        <i class="fas fa-comment me-1"></i>
                                                        <strong>General Feedback</strong>
                                                    </small>
                                                </div>
                                            }
                                        </div>
                                        <div class="card-footer bg-transparent">
                                            <div class="btn-group w-100">
                                                <a href="@Url.Action("Details", new { id = feedback.FeedbackID })" 
                                                   class="btn btn-sm btn-outline-info">
                                                    <i class="fas fa-eye me-1"></i>Details
                                                </a>
                                                <a href="@Url.Action("Respond", new { id = feedback.FeedbackID })" 
                                                   class="btn btn-sm btn-outline-primary">
                                                    <i class="fas fa-reply me-1"></i>Respond
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-comments fa-3x text-muted mb-3"></i>
                            <h4 class="text-muted">No Recent Feedback</h4>
                            <p class="text-muted">No customer feedback has been submitted recently.</p>
                            <a href="@Url.Action("Index")" class="btn btn-primary">
                                <i class="fas fa-list me-2"></i>View All Feedback
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Auto-refresh every 30 seconds
            setInterval(function() {
                // You can add auto-refresh logic here if needed
                console.log('Checking for new feedback...');
            }, 30000);

            // Initialize tooltips
            $('[data-bs-toggle="tooltip"]').tooltip();
        });
    </script>
}
