@{
    ViewData["Title"] = "Test Notifications";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">🧪 Test Notification Services</h3>
                </div>
                <div class="card-body">
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle"></i>
                        This page helps test the Email and SMS notification services.
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="card border-primary">
                                <div class="card-header bg-primary text-white">
                                    <h5>📧 Test Email Service</h5>
                                </div>
                                <div class="card-body">
                                    <button type="button" class="btn btn-primary" onclick="testEmail()">
                                        <i class="fas fa-envelope"></i> Send Test Email
                                    </button>
                                    <div id="emailResult" class="mt-3"></div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="card border-success">
                                <div class="card-header bg-success text-white">
                                    <h5>📱 Test SMS Service</h5>
                                </div>
                                <div class="card-body">
                                    <button type="button" class="btn btn-success" onclick="testSms()">
                                        <i class="fas fa-sms"></i> Send Test SMS
                                    </button>
                                    <div id="smsResult" class="mt-3"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mt-4">
                        <div class="col-12">
                            <div class="card border-warning">
                                <div class="card-header bg-warning text-dark">
                                    <h5>🚀 Test Bulk Notification</h5>
                                </div>
                                <div class="card-body">
                                    <button type="button" class="btn btn-warning" onclick="testBulk()">
                                        <i class="fas fa-broadcast-tower"></i> Test Email/SMS Services
                                    </button>
                                    <button type="button" class="btn btn-success ml-2" onclick="testBulkSend()">
                                        <i class="fas fa-paper-plane"></i> Test Actual Bulk Send
                                    </button>
                                    <div id="bulkResult" class="mt-3"></div>
                                    <div id="bulkSendResult" class="mt-3"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4">
                        <a href="@Url.Action("Bulk")" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Back to Bulk Send
                        </a>
                        <a href="@Url.Action("Index")" class="btn btn-info">
                            <i class="fas fa-list"></i> View All Notifications
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function testEmail() {
    document.getElementById('emailResult').innerHTML = '<div class="spinner-border spinner-border-sm" role="status"></div> Testing email service...';
    
    fetch('/Notification/TestEmail', {
        method: 'GET'
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            document.getElementById('emailResult').innerHTML = '<div class="alert alert-success">✅ ' + data.message + '</div>';
        } else {
            document.getElementById('emailResult').innerHTML = '<div class="alert alert-danger">❌ ' + data.message + '</div>';
        }
    })
    .catch(error => {
        document.getElementById('emailResult').innerHTML = '<div class="alert alert-danger">❌ Error: ' + error + '</div>';
    });
}

function testSms() {
    document.getElementById('smsResult').innerHTML = '<div class="spinner-border spinner-border-sm" role="status"></div> Testing SMS service...';
    
    fetch('/Notification/TestSms', {
        method: 'GET'
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            document.getElementById('smsResult').innerHTML = '<div class="alert alert-success">✅ ' + data.message + '</div>';
        } else {
            document.getElementById('smsResult').innerHTML = '<div class="alert alert-danger">❌ ' + data.message + '</div>';
        }
    })
    .catch(error => {
        document.getElementById('smsResult').innerHTML = '<div class="alert alert-danger">❌ Error: ' + error + '</div>';
    });
}

function testBulk() {
    document.getElementById('bulkResult').innerHTML = '<div class="spinner-border spinner-border-sm" role="status"></div> Testing email/SMS services...';

    fetch('/Notification/TestBulk', {
        method: 'GET'
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            document.getElementById('bulkResult').innerHTML = '<div class="alert alert-success">✅ ' + data.message + '</div>';
        } else {
            document.getElementById('bulkResult').innerHTML = '<div class="alert alert-danger">❌ ' + data.message + '</div>';
        }
    })
    .catch(error => {
        document.getElementById('bulkResult').innerHTML = '<div class="alert alert-danger">❌ Error: ' + error + '</div>';
    });
}

function testBulkSend() {
    document.getElementById('bulkSendResult').innerHTML = '<div class="spinner-border spinner-border-sm" role="status"></div> Testing actual bulk notification send...';

    fetch('/Notification/TestBulkSend', {
        method: 'GET'
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            document.getElementById('bulkSendResult').innerHTML =
                '<div class="alert alert-success">✅ ' + data.message +
                '<br><small>Users notified: ' + data.userCount +
                '<br>User IDs: ' + data.userIds.join(', ') + '</small></div>';
        } else {
            document.getElementById('bulkSendResult').innerHTML = '<div class="alert alert-danger">❌ ' + data.message + '</div>';
        }
    })
    .catch(error => {
        document.getElementById('bulkSendResult').innerHTML = '<div class="alert alert-danger">❌ Error: ' + error + '</div>';
    });
}
</script>
