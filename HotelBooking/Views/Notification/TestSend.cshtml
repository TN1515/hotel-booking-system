@{
    ViewData["Title"] = "Test Send Notification";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h3 class="card-title">
                        <i class="fas fa-paper-plane me-2"></i>Test Send Notification
                    </h3>
                </div>
                <div class="card-body">
                    <form id="testSendForm">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label for="title" class="form-label">Title</label>
                                    <input type="text" class="form-control" id="title" name="title" placeholder="Enter notification title..." required>
                                </div>

                                <div class="form-group mb-3">
                                    <label for="message" class="form-label">Message</label>
                                    <textarea class="form-control" id="message" name="message" rows="4" placeholder="Enter notification message..." required></textarea>
                                </div>

                                <div class="form-group mb-3">
                                    <label for="type" class="form-label">Notification Type</label>
                                    <select class="form-control" id="type" name="type" required>
                                        <option value="">Select Type</option>
                                        <option value="System">System</option>
                                        <option value="Booking">Booking</option>
                                        <option value="Payment">Payment</option>
                                        <option value="Promotion">Promotion</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label for="sendTo" class="form-label">Send To</label>
                                    <select class="form-control" id="sendTo" name="sendTo" required>
                                        <option value="">Select Recipients</option>
                                        <option value="All">All Users</option>
                                        <option value="Role">By Role</option>
                                    </select>
                                </div>

                                <div class="form-group mb-3" id="roleDiv" style="display: none;">
                                    <label for="roleName" class="form-label">Select Role</label>
                                    <select class="form-control" id="roleName" name="roleName">
                                        <option value="">Select Role</option>
                                        <option value="Admin">Admin</option>
                                        <option value="Staff">Staff</option>
                                        <option value="Customer">Customer</option>
                                    </select>
                                </div>

                                <div class="alert alert-info">
                                    <i class="fas fa-info-circle me-2"></i>
                                    <strong>Quick Test:</strong> This form will send notifications immediately to selected recipients.
                                </div>
                            </div>
                        </div>

                        <div class="form-group mt-3">
                            <button type="submit" class="btn btn-success btn-lg">
                                <i class="fas fa-paper-plane me-2"></i>Send Notification
                            </button>
                            <a href="@Url.Action("Index")" class="btn btn-secondary btn-lg ms-2">
                                <i class="fas fa-arrow-left me-2"></i>Back to List
                            </a>
                        </div>
                    </form>

                    <div id="result" class="mt-3" style="display: none;"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
$(document).ready(function() {
    // Show/hide role selection
    $('#sendTo').change(function() {
        if ($(this).val() === 'Role') {
            $('#roleDiv').show();
            $('#roleName').attr('required', true);
        } else {
            $('#roleDiv').hide();
            $('#roleName').attr('required', false);
        }
    });

    // Handle form submission
    $('#testSendForm').submit(function(e) {
        e.preventDefault();
        
        var formData = {
            Title: $('#title').val(),
            Message: $('#message').val(),
            Type: $('#type').val(),
            SendTo: $('#sendTo').val(),
            RoleName: $('#roleName').val(),
            SendImmediately: true
        };

        // Show loading
        $('#result').html(`
            <div class="alert alert-info">
                <i class="fas fa-spinner fa-spin me-2"></i>Sending notification...
            </div>
        `).show();

        $.ajax({
            url: '@Url.Action("Send", "Notification")',
            type: 'POST',
            data: formData,
            headers: {
                'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(response) {
                if (response.success || response.redirectUrl) {
                    $('#result').html(`
                        <div class="alert alert-success">
                            <i class="fas fa-check-circle me-2"></i>
                            <strong>Success!</strong> Notification sent successfully.
                        </div>
                    `);
                    
                    // Clear form
                    $('#testSendForm')[0].reset();
                    $('#roleDiv').hide();
                } else {
                    $('#result').html(`
                        <div class="alert alert-danger">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            <strong>Error!</strong> Failed to send notification.
                        </div>
                    `);
                }
            },
            error: function(xhr, status, error) {
                var errorMessage = 'Unknown error occurred';
                if (xhr.responseJSON && xhr.responseJSON.message) {
                    errorMessage = xhr.responseJSON.message;
                } else if (xhr.responseText) {
                    errorMessage = xhr.responseText;
                }
                
                $('#result').html(`
                    <div class="alert alert-danger">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <strong>Error!</strong> ${errorMessage}
                    </div>
                `);
            }
        });
    });
});
</script>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
