@{
    ViewData["Title"] = "System Logs";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="mb-1">
                        <i class="fas fa-file-alt text-primary me-2"></i>
                        System Logs
                    </h2>
                    <p class="text-muted mb-0">Monitor system activities and events</p>
                </div>
                <div>
                    <button type="button" class="btn btn-outline-primary me-2" onclick="refreshLogs()">
                        <i class="fas fa-sync-alt"></i> Refresh
                    </button>
                    <button type="button" class="btn btn-outline-secondary" onclick="exportLogs()">
                        <i class="fas fa-download"></i> Export
                    </button>
                </div>
            </div>

            <!-- Filters -->
            <div class="card mb-4">
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3">
                            <label for="logLevel" class="form-label">Log Level</label>
                            <select id="logLevel" class="form-select">
                                <option value="">All Levels</option>
                                <option value="Info">Information</option>
                                <option value="Warning">Warning</option>
                                <option value="Error">Error</option>
                                <option value="Critical">Critical</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label for="logCategory" class="form-label">Category</label>
                            <select id="logCategory" class="form-select">
                                <option value="">All Categories</option>
                                <option value="Authentication">Authentication</option>
                                <option value="Booking">Booking</option>
                                <option value="Payment">Payment</option>
                                <option value="Database">Database</option>
                                <option value="System">System</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label for="fromDate" class="form-label">From Date</label>
                            <input type="date" id="fromDate" class="form-control">
                        </div>
                        <div class="col-md-3">
                            <label for="toDate" class="form-label">To Date</label>
                            <input type="date" id="toDate" class="form-control">
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <label for="searchTerm" class="form-label">Search</label>
                            <input type="text" id="searchTerm" class="form-control" placeholder="Search in log messages...">
                        </div>
                        <div class="col-md-6 d-flex align-items-end">
                            <button type="button" class="btn btn-primary me-2" onclick="filterLogs()">
                                <i class="fas fa-search"></i> Filter
                            </button>
                            <button type="button" class="btn btn-outline-secondary" onclick="clearFilters()">
                                <i class="fas fa-times"></i> Clear
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Log Statistics -->
            <div class="row mb-4">
                <div class="col-md-3">
                    <div class="card border-info">
                        <div class="card-body text-center">
                            <i class="fas fa-info-circle fa-2x text-info mb-2"></i>
                            <h4 class="mb-1" id="infoCount">0</h4>
                            <p class="text-muted mb-0">Information</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-warning">
                        <div class="card-body text-center">
                            <i class="fas fa-exclamation-triangle fa-2x text-warning mb-2"></i>
                            <h4 class="mb-1" id="warningCount">0</h4>
                            <p class="text-muted mb-0">Warnings</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-danger">
                        <div class="card-body text-center">
                            <i class="fas fa-times-circle fa-2x text-danger mb-2"></i>
                            <h4 class="mb-1" id="errorCount">0</h4>
                            <p class="text-muted mb-0">Errors</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-dark">
                        <div class="card-body text-center">
                            <i class="fas fa-skull fa-2x text-dark mb-2"></i>
                            <h4 class="mb-1" id="criticalCount">0</h4>
                            <p class="text-muted mb-0">Critical</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Logs Table -->
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-list"></i> System Logs
                        <span class="badge bg-secondary ms-2" id="totalLogs">0 logs</span>
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover mb-0" id="logsTable">
                            <thead class="table-dark">
                                <tr>
                                    <th>Timestamp</th>
                                    <th>Level</th>
                                    <th>Category</th>
                                    <th>Message</th>
                                    <th>User</th>
                                    <th>IP Address</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody id="logsTableBody">
                                <!-- Logs will be loaded here -->
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer">
                    <nav>
                        <ul class="pagination pagination-sm mb-0" id="logsPagination">
                            <!-- Pagination will be generated here -->
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Log Details Modal -->
<div class="modal fade" id="logDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Log Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="logDetailsContent">
                    <!-- Log details will be loaded here -->
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Set default dates
            var today = new Date();
            var weekAgo = new Date(today.getTime() - 7 * 24 * 60 * 60 * 1000);
            
            $('#fromDate').val(weekAgo.toISOString().split('T')[0]);
            $('#toDate').val(today.toISOString().split('T')[0]);
            
            // Load initial logs
            loadLogs();
            
            // Auto-refresh every 30 seconds
            setInterval(function() {
                if (!$('#logDetailsModal').hasClass('show')) {
                    loadLogs();
                }
            }, 30000);
        });

        function loadLogs(page = 1) {
            var filters = {
                level: $('#logLevel').val(),
                category: $('#logCategory').val(),
                fromDate: $('#fromDate').val(),
                toDate: $('#toDate').val(),
                searchTerm: $('#searchTerm').val(),
                page: page
            };

            $.ajax({
                url: '@Url.Action("GetSystemLogs", "Admin")',
                type: 'GET',
                data: filters,
                success: function(response) {
                    updateLogsTable(response.logs);
                    updateLogStatistics(response.statistics);
                    updatePagination(response.pagination);
                },
                error: function() {
                    showError('Failed to load system logs');
                }
            });
        }

        function updateLogsTable(logs) {
            var tbody = $('#logsTableBody');
            tbody.empty();

            if (logs.length === 0) {
                tbody.append(`
                    <tr>
                        <td colspan="7" class="text-center py-4">
                            <i class="fas fa-file-alt fa-2x text-muted mb-2"></i>
                            <p class="text-muted mb-0">No logs found for the selected criteria</p>
                        </td>
                    </tr>
                `);
                return;
            }

            logs.forEach(function(log) {
                var levelBadge = getLevelBadge(log.level);
                var row = `
                    <tr>
                        <td>
                            <small>${new Date(log.timestamp).toLocaleString()}</small>
                        </td>
                        <td>${levelBadge}</td>
                        <td>
                            <span class="badge bg-light text-dark">${log.category}</span>
                        </td>
                        <td>
                            <div class="log-message" title="${log.message}">
                                ${log.message.length > 100 ? log.message.substring(0, 100) + '...' : log.message}
                            </div>
                        </td>
                        <td>
                            <small>${log.user || 'System'}</small>
                        </td>
                        <td>
                            <small>${log.ipAddress || 'N/A'}</small>
                        </td>
                        <td>
                            <button type="button" class="btn btn-sm btn-outline-primary" 
                                    onclick="showLogDetails(${log.id})">
                                <i class="fas fa-eye"></i>
                            </button>
                        </td>
                    </tr>
                `;
                tbody.append(row);
            });
        }

        function updateLogStatistics(stats) {
            $('#infoCount').text(stats.infoCount.toLocaleString());
            $('#warningCount').text(stats.warningCount.toLocaleString());
            $('#errorCount').text(stats.errorCount.toLocaleString());
            $('#criticalCount').text(stats.criticalCount.toLocaleString());
            $('#totalLogs').text(stats.totalCount.toLocaleString() + ' logs');
        }

        function updatePagination(pagination) {
            var paginationHtml = '';
            
            if (pagination.totalPages > 1) {
                // Previous button
                if (pagination.currentPage > 1) {
                    paginationHtml += `<li class="page-item">
                        <a class="page-link" href="#" onclick="loadLogs(${pagination.currentPage - 1})">Previous</a>
                    </li>`;
                }
                
                // Page numbers
                for (var i = Math.max(1, pagination.currentPage - 2); 
                     i <= Math.min(pagination.totalPages, pagination.currentPage + 2); i++) {
                    var activeClass = i === pagination.currentPage ? 'active' : '';
                    paginationHtml += `<li class="page-item ${activeClass}">
                        <a class="page-link" href="#" onclick="loadLogs(${i})">${i}</a>
                    </li>`;
                }
                
                // Next button
                if (pagination.currentPage < pagination.totalPages) {
                    paginationHtml += `<li class="page-item">
                        <a class="page-link" href="#" onclick="loadLogs(${pagination.currentPage + 1})">Next</a>
                    </li>`;
                }
            }
            
            $('#logsPagination').html(paginationHtml);
        }

        function getLevelBadge(level) {
            switch (level.toLowerCase()) {
                case 'info':
                case 'information':
                    return '<span class="badge bg-info">Info</span>';
                case 'warning':
                    return '<span class="badge bg-warning">Warning</span>';
                case 'error':
                    return '<span class="badge bg-danger">Error</span>';
                case 'critical':
                    return '<span class="badge bg-dark">Critical</span>';
                default:
                    return '<span class="badge bg-secondary">' + level + '</span>';
            }
        }

        function showLogDetails(logId) {
            $.ajax({
                url: '@Url.Action("GetLogDetails", "Admin")',
                type: 'GET',
                data: { id: logId },
                success: function(log) {
                    var content = `
                        <div class="row">
                            <div class="col-md-6">
                                <strong>Timestamp:</strong><br>
                                <span class="text-muted">${new Date(log.timestamp).toLocaleString()}</span>
                            </div>
                            <div class="col-md-6">
                                <strong>Level:</strong><br>
                                ${getLevelBadge(log.level)}
                            </div>
                        </div>
                        <hr>
                        <div class="row">
                            <div class="col-md-6">
                                <strong>Category:</strong><br>
                                <span class="badge bg-light text-dark">${log.category}</span>
                            </div>
                            <div class="col-md-6">
                                <strong>User:</strong><br>
                                <span class="text-muted">${log.user || 'System'}</span>
                            </div>
                        </div>
                        <hr>
                        <div class="mb-3">
                            <strong>Message:</strong><br>
                            <div class="bg-light p-3 rounded mt-2">
                                ${log.message}
                            </div>
                        </div>
                        ${log.exception ? `
                            <div class="mb-3">
                                <strong>Exception:</strong><br>
                                <div class="bg-danger text-white p-3 rounded mt-2">
                                    <pre class="mb-0">${log.exception}</pre>
                                </div>
                            </div>
                        ` : ''}
                        <div class="row">
                            <div class="col-md-6">
                                <strong>IP Address:</strong><br>
                                <span class="text-muted">${log.ipAddress || 'N/A'}</span>
                            </div>
                            <div class="col-md-6">
                                <strong>User Agent:</strong><br>
                                <span class="text-muted small">${log.userAgent || 'N/A'}</span>
                            </div>
                        </div>
                    `;
                    
                    $('#logDetailsContent').html(content);
                    $('#logDetailsModal').modal('show');
                },
                error: function() {
                    showError('Failed to load log details');
                }
            });
        }

        function filterLogs() {
            loadLogs(1);
        }

        function clearFilters() {
            $('#logLevel').val('');
            $('#logCategory').val('');
            $('#searchTerm').val('');
            
            var today = new Date();
            var weekAgo = new Date(today.getTime() - 7 * 24 * 60 * 60 * 1000);
            
            $('#fromDate').val(weekAgo.toISOString().split('T')[0]);
            $('#toDate').val(today.toISOString().split('T')[0]);
            
            loadLogs(1);
        }

        function refreshLogs() {
            loadLogs(1);
        }

        function exportLogs() {
            var filters = {
                level: $('#logLevel').val(),
                category: $('#logCategory').val(),
                fromDate: $('#fromDate').val(),
                toDate: $('#toDate').val(),
                searchTerm: $('#searchTerm').val()
            };

            var queryString = $.param(filters);
            window.open('@Url.Action("ExportLogs", "Admin")?' + queryString, '_blank');
        }

        function showError(message) {
            // You can implement a toast notification here
            alert(message);
        }
    </script>
}
