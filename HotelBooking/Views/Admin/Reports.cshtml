@model dynamic
@{
    ViewData["Title"] = "Reports & Analytics";
    Layout = "_AdminLayout";
}

<div class="admin-content">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="page-title">Reports & Analytics</h1>
            <p class="text-muted mb-0">Comprehensive business insights and performance metrics.</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-primary" onclick="exportReport()">
                <i class="fas fa-download me-2"></i>Export PDF
            </button>
            <button class="btn btn-outline-success" onclick="exportExcel()">
                <i class="fas fa-file-excel me-2"></i>Export Excel
            </button>
        </div>
    </div>

    <!-- Revenue Overview -->
    <div class="row mb-4">
        <div class="col-lg-4 col-md-6 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <h6 class="text-muted mb-1">Today's Revenue</h6>
                            <h3 class="mb-0 fw-bold text-success">@Model.TodayRevenue.ToString("C", new System.Globalization.CultureInfo("vi-VN"))</h3>
                            <small class="text-muted">@Model.TodayBookings bookings today</small>
                        </div>
                        <div class="text-success">
                            <i class="fas fa-chart-line fa-2x"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4 col-md-6 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <h6 class="text-muted mb-1">This Month</h6>
                            <h3 class="mb-0 fw-bold text-primary">@Model.ThisMonthRevenue.ToString("C", new System.Globalization.CultureInfo("vi-VN"))</h3>
                            <small class="text-muted">@Model.ThisMonthBookings bookings</small>
                        </div>
                        <div class="text-primary">
                            <i class="fas fa-calendar-alt fa-2x"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4 col-md-6 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <h6 class="text-muted mb-1">Last Month</h6>
                            <h3 class="mb-0 fw-bold text-info">@Model.LastMonthRevenue.ToString("C", new System.Globalization.CultureInfo("vi-VN"))</h3>
                            <small class="text-muted">@Model.LastMonthBookings bookings</small>
                            @{
                                var growth = Model.LastMonthRevenue > 0 ? ((Model.ThisMonthRevenue - Model.LastMonthRevenue) / Model.LastMonthRevenue * 100) : 0;
                            }
                            <div class="mt-1">
                                <span class="badge @(growth >= 0 ? "bg-success" : "bg-danger")">
                                    <i class="fas fa-arrow-@(growth >= 0 ? "up" : "down") me-1"></i>
                                    @Math.Abs(growth).ToString("F1")%
                                </span>
                            </div>
                        </div>
                        <div class="text-info">
                            <i class="fas fa-chart-bar fa-2x"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row -->
    <div class="row mb-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Monthly Revenue Trend</h5>
                </div>
                <div class="card-body">
                    <canvas id="revenueChart" height="100"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Room Occupancy</h5>
                </div>
                <div class="card-body text-center">
                    <div class="position-relative d-inline-block">
                        <canvas id="occupancyChart" width="200" height="200"></canvas>
                        <div class="position-absolute top-50 start-50 translate-middle">
                            <h3 class="mb-0">@(Model.TotalRooms > 0 ? Math.Round((decimal)Model.OccupiedRooms / Model.TotalRooms * 100, 1) : 0)%</h3>
                            <small class="text-muted">Occupied</small>
                        </div>
                    </div>
                    <div class="mt-3">
                        <div class="d-flex justify-content-between">
                            <span>Occupied:</span>
                            <strong>@Model.OccupiedRooms</strong>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>Available:</span>
                            <strong>@(Model.TotalRooms - Model.OccupiedRooms)</strong>
                        </div>
                        <div class="d-flex justify-content-between border-top pt-2 mt-2">
                            <span>Total Rooms:</span>
                            <strong>@Model.TotalRooms</strong>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Payment Analytics -->
    <div class="row mb-4">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Payment Analytics</h5>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-4">
                            <div class="border-end">
                                <h4 class="text-success mb-1">@Model.CompletedPayments.ToString("C", new System.Globalization.CultureInfo("vi-VN"))</h4>
                                <small class="text-muted">Completed</small>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="border-end">
                                <h4 class="text-warning mb-1">@Model.PendingPayments.ToString("C", new System.Globalization.CultureInfo("vi-VN"))</h4>
                                <small class="text-muted">Pending</small>
                            </div>
                        </div>
                        <div class="col-4">
                            <h4 class="text-primary mb-1">@Model.TotalPayments.ToString("C", new System.Globalization.CultureInfo("vi-VN"))</h4>
                            <small class="text-muted">Total</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Top Customers</h5>
                </div>
                <div class="card-body">
                    @if (Model.TopCustomers != null && Model.TopCustomers.Count > 0)
                    {
                        @foreach (var customer in Model.TopCustomers)
                        {
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div>
                                    <strong>@customer.CustomerName</strong>
                                    <small class="text-muted d-block">@customer.TotalBookings bookings</small>
                                </div>
                                <span class="badge bg-primary">@customer.TotalSpent.ToString("C", new System.Globalization.CultureInfo("vi-VN"))</span>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted text-center">No customer data available</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3 mb-2">
                            <a href="@Url.Action("PaymentManagement")" class="btn btn-outline-primary w-100">
                                <i class="fas fa-credit-card me-2"></i>Payment Management
                            </a>
                        </div>
                        <div class="col-md-3 mb-2">
                            <a href="@Url.Action("Reservations")" class="btn btn-outline-success w-100">
                                <i class="fas fa-calendar-check me-2"></i>View All Bookings
                            </a>
                        </div>
                        <div class="col-md-3 mb-2">
                            <a href="@Url.Action("Index", "Rooms")" class="btn btn-outline-info w-100">
                                <i class="fas fa-bed me-2"></i>Manage Rooms
                            </a>
                        </div>
                        <div class="col-md-3 mb-2">
                            <a href="@Url.Action("Index", "GuestProfile")" class="btn btn-outline-warning w-100">
                                <i class="fas fa-users me-2"></i>Customer Management
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Revenue Chart
        const revenueCtx = document.getElementById('revenueChart').getContext('2d');
        const monthlyData = @Html.Raw(Json.Serialize(Model.MonthlyRevenue));
        
        new Chart(revenueCtx, {
            type: 'line',
            data: {
                labels: monthlyData.map(d => d.month),
                datasets: [{
                    label: 'Revenue (VND)',
                    data: monthlyData.map(d => d.revenue),
                    borderColor: 'rgb(75, 192, 192)',
                    backgroundColor: 'rgba(75, 192, 192, 0.1)',
                    tension: 0.1,
                    fill: true
                }, {
                    label: 'Bookings',
                    data: monthlyData.map(d => d.bookings),
                    borderColor: 'rgb(255, 99, 132)',
                    backgroundColor: 'rgba(255, 99, 132, 0.1)',
                    yAxisID: 'y1',
                    tension: 0.1
                }]
            },
            options: {
                responsive: true,
                scales: {
                    y: {
                        type: 'linear',
                        display: true,
                        position: 'left',
                    },
                    y1: {
                        type: 'linear',
                        display: true,
                        position: 'right',
                        grid: {
                            drawOnChartArea: false,
                        },
                    }
                }
            }
        });

        // Occupancy Chart
        const occupancyCtx = document.getElementById('occupancyChart').getContext('2d');
        new Chart(occupancyCtx, {
            type: 'doughnut',
            data: {
                labels: ['Occupied', 'Available'],
                datasets: [{
                    data: [@Model.OccupiedRooms, @(Model.TotalRooms - Model.OccupiedRooms)],
                    backgroundColor: ['#28a745', '#e9ecef'],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: false,
                maintainAspectRatio: false,
                cutout: '70%',
                plugins: {
                    legend: {
                        display: false
                    }
                }
            }
        });

        // Export functions
        function exportReport() {
            // Show loading message
            Swal.fire({
                title: 'Exporting Report...',
                text: 'Please wait while we generate your PDF report.',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            // Redirect to export PDF action
            window.location.href = '@Url.Action("ExportReportPDF", "Admin")';

            // Close loading after a short delay
            setTimeout(() => {
                Swal.close();
                Swal.fire({
                    icon: 'success',
                    title: 'Export Successful!',
                    text: 'Your PDF report has been downloaded.',
                    timer: 2000,
                    showConfirmButton: false
                });
            }, 2000);
        }

        function exportExcel() {
            // Show loading message
            Swal.fire({
                title: 'Exporting to Excel...',
                text: 'Please wait while we generate your Excel file.',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            // Redirect to export Excel action
            window.location.href = '@Url.Action("ExportReportExcel", "Admin")';

            // Close loading after a short delay
            setTimeout(() => {
                Swal.close();
                Swal.fire({
                    icon: 'success',
                    title: 'Export Successful!',
                    text: 'Your Excel file has been downloaded.',
                    timer: 2000,
                    showConfirmButton: false
                });
            }, 2000);
        }
    </script>
}
