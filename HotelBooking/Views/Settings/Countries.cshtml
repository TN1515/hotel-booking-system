@model IEnumerable<HotelBooking.Models.Country>
@{
    ViewData["Title"] = "Countries Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="mb-1">
                        <i class="fas fa-globe text-primary me-2"></i>
                        Countries Management
                    </h2>
                    <p class="text-muted mb-0">Manage countries for guest profiles</p>
                </div>
                <div>
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-2"></i>Back to Settings
                    </a>
                </div>
            </div>

            <div class="row">
                <!-- Add New Country -->
                <div class="col-lg-4 mb-4">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-info text-white">
                            <h5 class="mb-0">
                                <i class="fas fa-plus me-2"></i>Add New Country
                            </h5>
                        </div>
                        <div class="card-body">
                            <form asp-action="CreateCountry" method="post">
                                <div class="mb-3">
                                    <label for="countryName" class="form-label">Country Name</label>
                                    <input type="text" class="form-control" id="countryName" name="countryName" required>
                                </div>
                                <div class="mb-3">
                                    <label for="countryCode" class="form-label">Country Code</label>
                                    <input type="text" class="form-control" id="countryCode" name="countryCode" maxlength="3" placeholder="VN, US, UK...">
                                </div>
                                <button type="submit" class="btn btn-info w-100">
                                    <i class="fas fa-save me-2"></i>Create Country
                                </button>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- Existing Countries -->
                <div class="col-lg-8">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">
                                <i class="fas fa-list me-2"></i>Existing Countries
                            </h5>
                        </div>
                        <div class="card-body p-0">
                            @if (Model.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-striped table-hover">
                                        <thead class="table-dark">
                                            <tr>
                                                <th>Country Name</th>
                                                <th>Country Code</th>
                                                <th>Status</th>
                                                <th>Created Date</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var country in Model)
                                            {
                                                <tr>
                                                    <td><strong>@country.CountryName</strong></td>
                                                    <td><span class="badge bg-secondary">@country.CountryCode</span></td>
                                                    <td><span class="badge bg-@(country.IsActive ? "success" : "secondary")">@(country.IsActive ? "Active" : "Inactive")</span></td>
                                                    <td><small class="text-muted">@country.CreatedDate.ToString("MMM dd, yyyy")</small></td>
                                                    <td>
                                                        <div class="btn-group btn-group-sm">
                                                            <button type="button" 
                                                                    class="btn btn-outline-@(country.IsActive ? "warning" : "success")"
                                                                    onclick="toggleStatus('country', @country.CountryID)">
                                                                <i class="fas fa-@(country.IsActive ? "pause" : "play") me-1"></i>
                                                                @(country.IsActive ? "Deactivate" : "Activate")
                                                            </button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-5">
                                    <i class="fas fa-globe fa-3x text-muted mb-3"></i>
                                    <h5 class="text-muted">No Countries Found</h5>
                                    <p class="text-muted">Create your first country to get started.</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleStatus(entityType, id) {
            if (confirm('Are you sure you want to change the status of this item?')) {
                $.post('@Url.Action("ToggleStatus")', {
                    entityType: entityType,
                    id: id
                }, function(response) {
                    if (response.success) {
                        location.reload();
                    } else {
                        alert('Error: ' + response.message);
                    }
                });
            }
        }

        // Show success message if exists
        @if (TempData["SuccessMessage"] != null)
        {
            <text>
            $(document).ready(function() {
                showSuccessMessage('@TempData["SuccessMessage"]');
            });
            </text>
        }

        function showSuccessMessage(message) {
            const alertHtml = `
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle me-2"></i>${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            `;
            $('.container-fluid').prepend(alertHtml);
            
            // Auto dismiss after 5 seconds
            setTimeout(function() {
                $('.alert').alert('close');
            }, 5000);
        }
    </script>
}
