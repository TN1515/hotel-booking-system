@model IEnumerable<HotelBooking.Models.LoyaltyTier>
@{
    ViewData["Title"] = "Loyalty Tiers Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="mb-1">
                        <i class="fas fa-star text-warning me-2"></i>
                        Loyalty Tiers Management
                    </h2>
                    <p class="text-muted mb-0">Manage loyalty program tiers and rewards</p>
                </div>
                <div>
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-2"></i>Back to Settings
                    </a>
                </div>
            </div>

            <div class="row">
                <!-- Add New Loyalty Tier -->
                <div class="col-lg-4 mb-4">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-warning text-dark">
                            <h5 class="mb-0">
                                <i class="fas fa-plus me-2"></i>Add New Loyalty Tier
                            </h5>
                        </div>
                        <div class="card-body">
                            <form asp-action="CreateLoyaltyTier" method="post">
                                <div class="mb-3">
                                    <label for="tierName" class="form-label">Tier Name</label>
                                    <input type="text" class="form-control" id="tierName" name="tierName" placeholder="Bronze, Silver, Gold..." required>
                                </div>
                                <div class="mb-3">
                                    <label for="minPoints" class="form-label">Minimum Points</label>
                                    <input type="number" class="form-control" id="minPoints" name="minPoints" min="0" required>
                                </div>
                                <div class="mb-3">
                                    <label for="maxPoints" class="form-label">Maximum Points</label>
                                    <input type="number" class="form-control" id="maxPoints" name="maxPoints" min="0" required>
                                </div>
                                <div class="mb-3">
                                    <label for="discountPercentage" class="form-label">Discount Percentage (%)</label>
                                    <input type="number" class="form-control" id="discountPercentage" name="discountPercentage" step="0.01" min="0" max="100" required>
                                </div>
                                <button type="submit" class="btn btn-warning w-100">
                                    <i class="fas fa-save me-2"></i>Create Loyalty Tier
                                </button>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- Existing Loyalty Tiers -->
                <div class="col-lg-8">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">
                                <i class="fas fa-list me-2"></i>Existing Loyalty Tiers
                            </h5>
                        </div>
                        <div class="card-body p-0">
                            @if (Model.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Tier Name</th>
                                                <th>Points Range</th>
                                                <th>Discount</th>
                                                <th>Status</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var tier in Model)
                                            {
                                                <tr>
                                                    <td>
                                                        <div class="d-flex align-items-center">
                                                            <i class="fas fa-star text-warning me-2"></i>
                                                            <strong>@tier.TierName</strong>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <span class="badge bg-info">@tier.MinPoints - @tier.MaxPoints points</span>
                                                    </td>
                                                    <td>
                                                        <span class="badge bg-success">@tier.DiscountPercentage%</span>
                                                    </td>
                                                    <td>
                                                        <span class="badge bg-@(tier.IsActive ? "success" : "secondary")">
                                                            @(tier.IsActive ? "Active" : "Inactive")
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <div class="btn-group btn-group-sm">
                                                            <button type="button" 
                                                                    class="btn btn-outline-@(tier.IsActive ? "warning" : "success")"
                                                                    onclick="toggleStatus('loyaltytier', @tier.LoyaltyTierID)">
                                                                <i class="fas fa-@(tier.IsActive ? "pause" : "play") me-1"></i>
                                                                @(tier.IsActive ? "Deactivate" : "Activate")
                                                            </button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-5">
                                    <i class="fas fa-star fa-3x text-muted mb-3"></i>
                                    <h5 class="text-muted">No Loyalty Tiers Found</h5>
                                    <p class="text-muted">Create your first loyalty tier to get started.</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Loyalty Program Info -->
            <div class="row mt-4">
                <div class="col-12">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0">
                                <i class="fas fa-info-circle me-2"></i>Loyalty Program Information
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <h6>How Loyalty Points Work:</h6>
                                    <ul class="list-unstyled">
                                        <li><i class="fas fa-check text-success me-2"></i>Customers earn points for each booking</li>
                                        <li><i class="fas fa-check text-success me-2"></i>Points are calculated based on total amount spent</li>
                                        <li><i class="fas fa-check text-success me-2"></i>Higher tiers provide better discounts</li>
                                        <li><i class="fas fa-check text-success me-2"></i>Discounts apply to future bookings</li>
                                    </ul>
                                </div>
                                <div class="col-md-6">
                                    <h6>Tier Benefits:</h6>
                                    <ul class="list-unstyled">
                                        <li><i class="fas fa-star text-warning me-2"></i>Percentage discounts on bookings</li>
                                        <li><i class="fas fa-star text-warning me-2"></i>Priority customer support</li>
                                        <li><i class="fas fa-star text-warning me-2"></i>Early access to promotions</li>
                                        <li><i class="fas fa-star text-warning me-2"></i>Special member rates</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleStatus(entityType, id) {
            if (confirm('Are you sure you want to change the status of this item?')) {
                $.post('@Url.Action("ToggleStatus")', {
                    entityType: entityType,
                    id: id
                }, function(response) {
                    if (response.success) {
                        location.reload();
                    } else {
                        alert('Error: ' + response.message);
                    }
                });
            }
        }

        // Show success message if exists
        @if (TempData["SuccessMessage"] != null)
        {
            <text>
            $(document).ready(function() {
                showSuccessMessage('@TempData["SuccessMessage"]');
            });
            </text>
        }

        function showSuccessMessage(message) {
            const alertHtml = `
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle me-2"></i>${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            `;
            $('.container-fluid').prepend(alertHtml);
            
            // Auto dismiss after 5 seconds
            setTimeout(function() {
                $('.alert').alert('close');
            }, 5000);
        }

        // Validate points range
        $('#maxPoints').on('input', function() {
            const minPoints = parseInt($('#minPoints').val()) || 0;
            const maxPoints = parseInt($(this).val()) || 0;
            
            if (maxPoints <= minPoints) {
                $(this).addClass('is-invalid');
                $(this).siblings('.invalid-feedback').remove();
                $(this).after('<div class="invalid-feedback">Maximum points must be greater than minimum points</div>');
            } else {
                $(this).removeClass('is-invalid');
                $(this).siblings('.invalid-feedback').remove();
            }
        });
    </script>
}
