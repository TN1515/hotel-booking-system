@model IEnumerable<HotelBooking.Models.RoomType>
@{
    ViewData["Title"] = "Room Types Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="mb-1">
                        <i class="fas fa-home text-primary me-2"></i>
                        Room Types Management
                    </h2>
                    <p class="text-muted mb-0">Manage room types and their configurations</p>
                </div>
                <div>
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-2"></i>Back to Settings
                    </a>
                </div>
            </div>

            <div class="row">
                <!-- Add New Room Type -->
                <div class="col-lg-4 mb-4">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0">
                                <i class="fas fa-plus me-2"></i>Add New Room Type
                            </h5>
                        </div>
                        <div class="card-body">
                            <form asp-action="CreateRoomType" method="post">
                                <div class="mb-3">
                                    <label for="typeName" class="form-label">Type Name</label>
                                    <input type="text" class="form-control" id="typeName" name="typeName" required>
                                </div>
                                <div class="mb-3">
                                    <label for="description" class="form-label">Description</label>
                                    <textarea class="form-control" id="description" name="description" rows="3"></textarea>
                                </div>
                                <div class="mb-3">
                                    <label for="maxOccupancy" class="form-label">Max Occupancy</label>
                                    <input type="number" class="form-control" id="maxOccupancy" name="maxOccupancy" min="1" max="10" required>
                                </div>

                                <button type="submit" class="btn btn-primary w-100">
                                    <i class="fas fa-save me-2"></i>Create Room Type
                                </button>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- Existing Room Types -->
                <div class="col-lg-8">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">
                                <i class="fas fa-list me-2"></i>Existing Room Types
                            </h5>
                        </div>
                        <div class="card-body p-0">
                            @if (Model.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Type Name</th>
                                                <th>Description</th>
                                                <th>Max Occupancy</th>
                                                <th>Status</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var roomType in Model)
                                            {
                                                <tr>
                                                    <td>
                                                        <strong>@roomType.TypeName</strong>
                                                    </td>
                                                    <td>
                                                        <small class="text-muted">@(roomType.Description ?? "No description")</small>
                                                    </td>
                                                    <td>
                                                        <span class="badge bg-info">@roomType.MaxOccupancy guests</span>
                                                    </td>
                                                    <td>
                                                        <span class="badge bg-@(roomType.IsActive ? "success" : "secondary")">
                                                            @(roomType.IsActive ? "Active" : "Inactive")
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <div class="btn-group btn-group-sm">
                                                            <button type="button" 
                                                                    class="btn btn-outline-@(roomType.IsActive ? "warning" : "success")"
                                                                    onclick="toggleStatus('roomtype', @roomType.RoomTypeID)">
                                                                <i class="fas fa-@(roomType.IsActive ? "pause" : "play") me-1"></i>
                                                                @(roomType.IsActive ? "Deactivate" : "Activate")
                                                            </button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-5">
                                    <i class="fas fa-home fa-3x text-muted mb-3"></i>
                                    <h5 class="text-muted">No Room Types Found</h5>
                                    <p class="text-muted">Create your first room type to get started.</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleStatus(entityType, id) {
            if (confirm('Are you sure you want to change the status of this item?')) {
                $.post('@Url.Action("ToggleStatus")', {
                    entityType: entityType,
                    id: id
                }, function(response) {
                    if (response.success) {
                        location.reload();
                    } else {
                        alert('Error: ' + response.message);
                    }
                });
            }
        }

        // Show success message if exists
        @if (TempData["SuccessMessage"] != null)
        {
            <text>
            $(document).ready(function() {
                showSuccessMessage('@TempData["SuccessMessage"]');
            });
            </text>
        }

        function showSuccessMessage(message) {
            const alertHtml = `
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle me-2"></i>${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            `;
            $('.container-fluid').prepend(alertHtml);
            
            // Auto dismiss after 5 seconds
            setTimeout(function() {
                $('.alert').alert('close');
            }, 5000);
        }
    </script>
}
