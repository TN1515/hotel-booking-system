@model HotelBooking.Models.Room
@{
    ViewData["Title"] = "Room Details";
}

<style>
    .room-hero {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 3rem 0;
        margin-bottom: 2rem;
    }

    .room-image-gallery {
        height: 300px;
        background: linear-gradient(45deg, #f8f9fa, #e9ecef);
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 2rem;
    }

    .feature-card {
        background: white;
        border-radius: 15px;
        padding: 1.5rem;
        box-shadow: 0 5px 15px rgba(0,0,0,0.08);
        margin-bottom: 1.5rem;
        transition: transform 0.3s ease;
    }

    .feature-card:hover {
        transform: translateY(-5px);
    }

    .amenity-badge {
        background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
        color: white;
        padding: 0.5rem 1rem;
        border-radius: 25px;
        margin: 0.25rem;
        display: inline-block;
        font-size: 0.875rem;
    }

    .price-highlight {
        background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
        color: white;
        padding: 1rem;
        border-radius: 15px;
        text-align: center;
    }
</style>

<div class="room-hero">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h1 class="page-title">Room @Model.RoomNumber</h1>
                <p class="lead mb-0">@Model.RoomType?.TypeName</p>
            </div>
            <div class="col-md-4 text-end">
                <span class="badge bg-@(Model.Status == "Available" ? "success" : Model.Status == "Occupied" ? "warning" : "danger") fs-6 px-3 py-2">
                    @Model.Status
                </span>
            </div>
        </div>
    </div>
</div>

<div class="container">
    <div class="row">
        <div class="col-lg-8">
            <!-- Room Image Gallery -->
            @if (Model.RoomImages != null && Model.RoomImages.Any(ri => ri.IsActive))
            {
                <div class="room-image-gallery-container mb-4">
                    <div id="roomImageCarousel" class="carousel slide" data-bs-ride="carousel">
                        <div class="carousel-indicators">
                            @{
                                var activeImages = Model.RoomImages.Where(ri => ri.IsActive).OrderBy(ri => ri.DisplayOrder).ToList();
                            }
                            @for (int i = 0; i < activeImages.Count; i++)
                            {
                                <button type="button" data-bs-target="#roomImageCarousel" data-bs-slide-to="@i"
                                        class="@(i == 0 ? "active" : "")" aria-current="@(i == 0 ? "true" : "false")"
                                        aria-label="Slide @(i + 1)"></button>
                            }
                        </div>
                        <div class="carousel-inner" style="border-radius: 15px; overflow: hidden;">
                            @for (int i = 0; i < activeImages.Count; i++)
                            {
                                var image = activeImages[i];
                                <div class="carousel-item @(i == 0 ? "active" : "")">
                                    @if (image.ImageData != null)
                                    {
                                        <img src="data:image/jpeg;base64,@Convert.ToBase64String(image.ImageData)"
                                             class="d-block w-100" alt="@(image.ImageName ?? "Room Image")"
                                             style="height: 400px; object-fit: cover;">
                                    }
                                    else if (!string.IsNullOrEmpty(image.ImagePath))
                                    {
                                        <img src="@image.ImagePath" class="d-block w-100" alt="@(image.ImageName ?? "Room Image")"
                                             style="height: 400px; object-fit: cover;">
                                    }
                                    else
                                    {
                                        <div class="d-flex align-items-center justify-content-center" style="height: 400px; background: #f8f9fa;">
                                            <div class="text-center">
                                                <i class="fas fa-image fa-3x text-muted mb-2"></i>
                                                <p class="text-muted">Image not available</p>
                                            </div>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(image.Description))
                                    {
                                        <div class="carousel-caption d-none d-md-block">
                                            <p>@image.Description</p>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                        @if (activeImages.Count > 1)
                        {
                            <button class="carousel-control-prev" type="button" data-bs-target="#roomImageCarousel" data-bs-slide="prev">
                                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                <span class="visually-hidden">Previous</span>
                            </button>
                            <button class="carousel-control-next" type="button" data-bs-target="#roomImageCarousel" data-bs-slide="next">
                                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                <span class="visually-hidden">Next</span>
                            </button>
                        }
                    </div>

                    @if (activeImages.Count > 1)
                    {
                        <div class="row mt-3">
                            @foreach (var image in activeImages.Take(4))
                            {
                                <div class="col-3">
                                    @if (image.ImageData != null)
                                    {
                                        <img src="data:image/jpeg;base64,@Convert.ToBase64String(image.ImageData)"
                                             class="img-thumbnail" alt="@(image.ImageName ?? "Room Image")"
                                             style="height: 80px; object-fit: cover; cursor: pointer;"
                                             onclick="showImageInCarousel(@activeImages.IndexOf(image))">
                                    }
                                    else if (!string.IsNullOrEmpty(image.ImagePath))
                                    {
                                        <img src="@image.ImagePath" class="img-thumbnail" alt="@(image.ImageName ?? "Room Image")"
                                             style="height: 80px; object-fit: cover; cursor: pointer;"
                                             onclick="showImageInCarousel(@activeImages.IndexOf(image))">
                                    }
                                    else
                                    {
                                        <div class="img-thumbnail d-flex align-items-center justify-content-center"
                                             style="height: 80px; background: #f8f9fa;">
                                            <i class="fas fa-image text-muted"></i>
                                        </div>
                                    }
                                </div>
                            }
                            @if (activeImages.Count > 4)
                            {
                                <div class="col-3 d-flex align-items-center justify-content-center">
                                    <span class="text-muted">+@(activeImages.Count - 4) more</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="room-image-gallery">
                    <div class="text-center">
                        <i class="fas fa-camera fa-4x text-muted mb-3"></i>
                        <h5 class="text-muted">Room Photos</h5>
                        <p class="text-muted">No photos available for this room yet</p>
                        @if (User.IsInRole("Admin") || User.IsInRole("Staff"))
                        {
                            <a href="@Url.Action("Edit", new { id = Model.RoomID })" class="btn btn-primary">
                                <i class="fas fa-plus me-2"></i>Add Photos
                            </a>
                        }
                    </div>
                </div>
            }

            <!-- Room Features -->
            <div class="row">
                <div class="col-md-6">
                    <div class="feature-card">
                        <h5 class="mb-3"><i class="fas fa-info-circle text-primary me-2"></i>Room Information</h5>
                        <div class="row">
                            <div class="col-6 mb-3">
                                <small class="text-muted d-block">Room Number</small>
                                <strong class="h6">@Model.RoomNumber</strong>
                            </div>
                            <div class="col-6 mb-3">
                                <small class="text-muted d-block">Room Type</small>
                                <strong class="h6">@Model.RoomType?.TypeName</strong>
                            </div>
                            <div class="col-6 mb-3">
                                <small class="text-muted d-block">Max Occupancy</small>
                                <strong class="h6"><i class="fas fa-users text-primary me-1"></i>@Model.RoomType?.MaxOccupancy guests</strong>
                            </div>
                            <div class="col-6 mb-3">
                                <small class="text-muted d-block">Bed Type</small>
                                <strong class="h6"><i class="fas fa-bed text-primary me-1"></i>@(Model.BedType ?? "Standard")</strong>
                            </div>
                            <div class="col-6 mb-3">
                                <small class="text-muted d-block">View Type</small>
                                <strong class="h6"><i class="fas fa-eye text-primary me-1"></i>@(Model.ViewType ?? "City View")</strong>
                            </div>
                            <div class="col-6 mb-3">
                                <small class="text-muted d-block">Status</small>
                                <span class="badge bg-@(Model.Status == "Available" ? "success" : Model.Status == "Occupied" ? "warning" : "danger")">
                                    @Model.Status
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="feature-card">
                        <h5 class="mb-3"><i class="fas fa-clipboard-list text-primary me-2"></i>Additional Details</h5>
                        @if (!string.IsNullOrEmpty(Model.Description))
                        {
                            <div class="mb-3">
                                <small class="text-muted d-block">Description</small>
                                <p class="mb-0">@Model.Description</p>
                            </div>
                        }
                        <div class="row">
                            <div class="col-12 mb-2">
                                <small class="text-muted">Created: @Model.CreatedDate.ToString("dd/MM/yyyy") by @(Model.CreatedBy ?? "System")</small>
                            </div>
                            @if (Model.ModifiedDate.HasValue)
                            {
                                <div class="col-12">
                                    <small class="text-muted">Modified: @Model.ModifiedDate.Value.ToString("dd/MM/yyyy") by @(Model.ModifiedBy ?? "System")</small>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Room Amenities -->
            @if (Model.RoomAmenities != null && Model.RoomAmenities.Any())
            {
                <div class="feature-card">
                    <h5 class="mb-3"><i class="fas fa-star text-primary me-2"></i>Room Amenities</h5>
                    <div class="row">
                        @foreach (var roomAmenity in Model.RoomAmenities.OrderBy(ra => ra.Amenity?.Category).ThenBy(ra => ra.Amenity?.AmenityName))
                        {
                            <div class="col-md-4 col-sm-6 mb-2">
                                <span class="amenity-badge">
                                    @if (!string.IsNullOrEmpty(roomAmenity.Amenity?.Icon))
                                    {
                                        <i class="@roomAmenity.Amenity.Icon me-1"></i>
                                    }
                                    else
                                    {
                                        <i class="fas fa-check me-1"></i>
                                    }
                                    @roomAmenity.Amenity?.AmenityName
                                </span>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="feature-card">
                    <div class="text-center py-4">
                        <i class="fas fa-info-circle fa-2x text-muted mb-3"></i>
                        <h6 class="text-muted">No amenities assigned to this room yet.</h6>
                    </div>
                </div>
            }
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">
            <!-- Price Card -->
            <div class="price-highlight mb-4">
                <h3 class="mb-2">$@Model.Price</h3>
                <p class="mb-0">per night</p>
            </div>

            <!-- Booking Card -->
            @if (Model.Status == "Available")
            {
                <div class="feature-card text-center">
                    <h5 class="mb-3">Ready to Book?</h5>
                    <p class="text-muted mb-3">This room is available for booking</p>

                    <!-- Quick Date Selection -->
                    <div class="mb-3">
                        <div class="row g-2">
                            <div class="col-6">
                                <label class="form-label small">Check-in</label>
                                <input type="date" id="quickCheckIn" class="form-control form-control-sm"
                                       value="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")"
                                       min="@DateTime.Today.ToString("yyyy-MM-dd")">
                            </div>
                            <div class="col-6">
                                <label class="form-label small">Check-out</label>
                                <input type="date" id="quickCheckOut" class="form-control form-control-sm"
                                       value="@DateTime.Today.AddDays(2).ToString("yyyy-MM-dd")"
                                       min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")">
                            </div>
                        </div>
                    </div>

                    <!-- Availability Status -->
                    <div id="quickAvailabilityStatus" class="mb-3" style="display: none;">
                        <!-- Will be populated by JavaScript -->
                    </div>

                    <button id="bookThisRoomBtn" class="btn btn-primary btn-lg w-100 mb-2">
                        <i class="fas fa-calendar-plus me-2"></i>Book This Room
                    </button>
                    <small class="text-muted">Free cancellation up to 24 hours</small>
                </div>
            }
            else
            {
                <div class="feature-card text-center">
                    <h5 class="mb-3 text-warning">Currently Unavailable</h5>
                    <p class="text-muted mb-3">This room is currently @(Model.Status?.ToLower() ?? "unavailable")</p>
                    <button class="btn btn-secondary btn-lg w-100" disabled>
                        <i class="fas fa-ban me-2"></i>Not Available
                    </button>
                </div>
            }

            <!-- Room Type Information -->
            @if (Model.RoomType != null)
            {
                <div class="feature-card">
                    <h5 class="mb-3"><i class="fas fa-home text-primary me-2"></i>Room Type Information</h5>
                    <div class="row">
                        <div class="col-md-6">
                            <small class="text-muted d-block">Type Name</small>
                            <strong class="h6">@Model.RoomType.TypeName</strong>
                        </div>
                        <div class="col-md-6">
                            <small class="text-muted d-block">Max Occupancy</small>
                            <strong class="h6">@Model.RoomType.MaxOccupancy guests</strong>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.RoomType.Description))
                        {
                            <div class="col-12 mt-3">
                                <small class="text-muted d-block">Description</small>
                                <p class="mb-0">@Model.RoomType.Description</p>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Admin Actions -->
            @if (User.IsInRole("Admin") || User.IsInRole("Staff"))
            {
                <div class="feature-card">
                    <h5 class="mb-3"><i class="fas fa-cog text-primary me-2"></i>Admin Actions</h5>
                    <div class="d-grid gap-2">
                        <a href="@Url.Action("Edit", new { id = Model.RoomID })" class="btn btn-warning">
                            <i class="fas fa-edit me-2"></i>Edit Room
                        </a>

                        <button type="button" class="btn btn-@(Model.IsActive ? "secondary" : "success")"
                                onclick="toggleRoomStatus(@Model.RoomID)">
                            @if (Model.IsActive)
                            {
                                <i class="fas fa-ban me-2"></i><text>Deactivate</text>
                            }
                            else
                            {
                                <i class="fas fa-check me-2"></i><text>Activate</text>
                            }
                        </button>

                        @if (User.IsInRole("Admin"))
                        {
                            <a href="@Url.Action("Delete", new { id = Model.RoomID })"
                               class="btn btn-danger"
                               onclick="return confirm('Are you sure you want to delete this room?')">
                                <i class="fas fa-trash me-2"></i>Delete Room
                            </a>
                        }
                    </div>
                </div>
            }

            <!-- Navigation -->
            <div class="feature-card">
                <div class="d-grid gap-2">
                    <a href="@Url.Action("Index")" class="btn btn-outline-primary">
                        <i class="fas fa-arrow-left me-2"></i>Back to All Rooms
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleRoomStatus(roomId) {
            if (confirm('Are you sure you want to change the room status?')) {
                fetch('@Url.Action("ToggleStatus")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                    },
                    body: JSON.stringify({ id: roomId })
                })
                .then(response => response.json())
                .then(result => {
                    if (result.success) {
                        location.reload();
                    } else {
                        alert('Error: ' + result.message);
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('An error occurred while updating room status.');
                });
            }
        }

        function showImageInCarousel(index) {
            const carousel = new bootstrap.Carousel(document.getElementById('roomImageCarousel'));
            carousel.to(index);
        }

        // Initialize carousel with auto-play
        $(document).ready(function() {
            const carousel = document.getElementById('roomImageCarousel');
            if (carousel) {
                const bsCarousel = new bootstrap.Carousel(carousel, {
                    interval: 5000,
                    wrap: true
                });
            }

            // Quick booking functionality
            const roomId = @Model.RoomID;

            function checkQuickAvailability() {
                const checkIn = $('#quickCheckIn').val();
                const checkOut = $('#quickCheckOut').val();

                if (!checkIn || !checkOut) {
                    hideQuickAvailabilityStatus();
                    return;
                }

                if (new Date(checkIn) >= new Date(checkOut)) {
                    showQuickAvailabilityStatus('warning', '<i class="fas fa-exclamation-triangle me-2"></i>Check-out must be after check-in date.', false);
                    return;
                }

                // Show loading
                showQuickAvailabilityStatus('info', '<i class="fas fa-spinner fa-spin me-2"></i>Checking availability...', false);

                $.ajax({
                    url: '@Url.Action("CheckAvailability", "Rooms")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        roomId: roomId,
                        checkInDate: checkIn,
                        checkOutDate: checkOut
                    }),
                    success: function(response) {
                        if (response.isAvailable) {
                            showQuickAvailabilityStatus('success', '<i class="fas fa-check-circle me-2"></i>Available! Ready to book.', true);
                        } else {
                            showQuickAvailabilityStatus('danger', '<i class="fas fa-exclamation-triangle me-2"></i>' + response.message, false);
                        }
                    },
                    error: function() {
                        showQuickAvailabilityStatus('warning', '<i class="fas fa-exclamation-triangle me-2"></i>Unable to check availability.', false);
                    }
                });
            }

            function showQuickAvailabilityStatus(type, message, enableBooking) {
                const statusDiv = $('#quickAvailabilityStatus');
                statusDiv.html(`<div class="alert alert-${type} alert-sm mb-0 small">${message}</div>`);
                statusDiv.show();

                $('#bookThisRoomBtn').prop('disabled', !enableBooking);
                if (!enableBooking) {
                    $('#bookThisRoomBtn').addClass('disabled');
                } else {
                    $('#bookThisRoomBtn').removeClass('disabled');
                }
            }

            function hideQuickAvailabilityStatus() {
                $('#quickAvailabilityStatus').hide();
                $('#bookThisRoomBtn').prop('disabled', false).removeClass('disabled');
            }

            // Event handlers
            $('#quickCheckIn, #quickCheckOut').on('change', checkQuickAvailability);

            $('#quickCheckIn').on('change', function() {
                const checkInDate = $(this).val();
                if (checkInDate) {
                    const nextDay = new Date(checkInDate);
                    nextDay.setDate(nextDay.getDate() + 1);
                    $('#quickCheckOut').attr('min', nextDay.toISOString().split('T')[0]);

                    // Auto-set checkout to next day if not set or invalid
                    const currentCheckOut = $('#quickCheckOut').val();
                    if (!currentCheckOut || new Date(currentCheckOut) <= new Date(checkInDate)) {
                        $('#quickCheckOut').val(nextDay.toISOString().split('T')[0]);
                    }
                }
            });

            $('#bookThisRoomBtn').on('click', function(e) {
                e.preventDefault();
                const checkIn = $('#quickCheckIn').val();
                const checkOut = $('#quickCheckOut').val();

                if ($(this).prop('disabled')) {
                    alert('Please select different dates. This room is not available for the selected period.');
                    return;
                }

                // Redirect to booking page with selected dates
                window.location.href = '@Url.Action("Book", "Rooms", new { id = Model.RoomID })' +
                    '?checkIn=' + encodeURIComponent(checkIn) +
                    '&checkOut=' + encodeURIComponent(checkOut) +
                    '&guests=1';
            });

            // Initial check
            checkQuickAvailability();
        });
    </script>
}
