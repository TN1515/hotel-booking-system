@model HotelBooking.Models.ViewModels.QRPaymentViewModel
@{
    ViewData["Title"] = "Create QR Payment";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-qrcode me-2"></i>
                        Tạo thanh toán QR Code
                    </h4>
                </div>
                <div class="card-body">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">
                            <ul class="mb-0">
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <li>@error.ErrorMessage</li>
                                }
                            </ul>
                        </div>
                    }

                    <!-- Reservation Information -->
                    <div class="card mb-4">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">Thông tin đặt phòng</h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <p><strong>Khách hàng:</strong> @Model.GuestName</p>
                                    <p><strong>Phòng:</strong> @Model.RoomNumber (@Model.RoomType)</p>
                                    <p><strong>Check-in:</strong> @Model.CheckInDate.ToString("dd/MM/yyyy")</p>
                                </div>
                                <div class="col-md-6">
                                    <p><strong>Check-out:</strong> @Model.CheckOutDate.ToString("dd/MM/yyyy")</p>
                                    <p><strong>Tổng tiền:</strong> <span class="text-success fw-bold">@Model.TotalAmount.ToString("C", new System.Globalization.CultureInfo("vi-VN"))</span></p>
                                    <p><strong>Đã thanh toán:</strong> <span class="text-info">@Model.PaidAmount.ToString("C", new System.Globalization.CultureInfo("vi-VN"))</span></p>
                                    <p><strong>Còn lại:</strong> <span class="text-danger fw-bold">@Model.RemainingAmount.ToString("C", new System.Globalization.CultureInfo("vi-VN"))</span></p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Payment Form -->
                    <form asp-action="Create" method="post">
                        <input type="hidden" asp-for="ReservationID" />
                        <input type="hidden" asp-for="GuestName" />
                        <input type="hidden" asp-for="RoomNumber" />
                        <input type="hidden" asp-for="RoomType" />
                        <input type="hidden" asp-for="CheckInDate" />
                        <input type="hidden" asp-for="CheckOutDate" />
                        <input type="hidden" asp-for="TotalAmount" />
                        <input type="hidden" asp-for="PaidAmount" />
                        <input type="hidden" asp-for="RemainingAmount" />

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Amount" class="form-label">Số tiền thanh toán</label>
                                    <div class="input-group">
                                        <span class="input-group-text">₫</span>
                                        <input asp-for="Amount" class="form-control" type="number" step="1000" min="1000" max="@Model.RemainingAmount" />
                                    </div>
                                    <span asp-validation-for="Amount" class="text-danger"></span>
                                    <div class="form-text">
                                        Số tiền tối đa: @Model.RemainingAmount.ToString("C", new System.Globalization.CultureInfo("vi-VN"))
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label">Phương thức thanh toán</label>
                                    <div class="card border-primary">
                                        <div class="card-body text-center">
                                            <i class="fas fa-qrcode fa-2x text-primary mb-2"></i>
                                            <h6 class="text-primary">QR Code VietinBank</h6>
                                            <small class="text-muted">Quét mã QR để thanh toán</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Notes" class="form-label">Ghi chú (tùy chọn)</label>
                            <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Nhập ghi chú nếu có..."></textarea>
                            <span asp-validation-for="Notes" class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a href="@Url.Action("Details", "Reservations", new { id = Model.ReservationID })" class="btn btn-secondary me-md-2">
                                <i class="fas fa-arrow-left me-1"></i>Quay lại
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-qrcode me-1"></i>Tạo QR Code
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        // Auto-fill with remaining amount
        document.addEventListener('DOMContentLoaded', function() {
            const amountInput = document.querySelector('input[name="Amount"]');
            const remainingAmount = @Model.RemainingAmount;
            
            if (amountInput.value === '' || amountInput.value === '0') {
                amountInput.value = remainingAmount;
            }
        });
    </script>
}
