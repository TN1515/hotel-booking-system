@model HotelBooking.Models.QRPayment
@{
    ViewData["Title"] = "Payment Successful";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-success">
                <div class="card-header bg-success text-white text-center">
                    <h3 class="mb-0">
                        <i class="fas fa-check-circle fa-2x mb-2"></i><br>
                        Payment Successful!
                    </h3>
                </div>
                <div class="card-body text-center">
                    <div class="alert alert-success">
                        <h4><i class="fas fa-thumbs-up me-2"></i>Thank you for your payment!</h4>
                        <p class="mb-0">Your payment has been processed successfully.</p>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <div class="card bg-light">
                                <div class="card-body">
                                    <h5 class="card-title">
                                        <i class="fas fa-credit-card text-primary"></i>
                                        Payment Details
                                    </h5>
                                    <p><strong>Amount:</strong> @Model.Amount.ToString("C", new System.Globalization.CultureInfo("vi-VN"))</p>
                                    <p><strong>Transaction ID:</strong> @Model.QRPaymentID</p>
                                    <p><strong>Payment Date:</strong> @Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")</p>
                                    <p><strong>Status:</strong>
                                        <span class="badge bg-success">@Model.Status</span>
                                    </p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card bg-light">
                                <div class="card-body">
                                    <h5 class="card-title">
                                        <i class="fas fa-university text-info"></i>
                                        Bank Details
                                    </h5>
                                    <p><strong>Bank:</strong> @Model.BankCode</p>
                                    <p><strong>Account:</strong> @Model.AccountNumber</p>
                                    <p><strong>Account Name:</strong> @Model.AccountName</p>
                                    <p><strong>Description:</strong> @Model.TransactionDescription</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <h5><i class="fas fa-info-circle text-info"></i> What's Next?</h5>
                        <div class="row">
                            <div class="col-md-4">
                                <div class="card h-100">
                                    <div class="card-body text-center">
                                        <i class="fas fa-envelope fa-2x text-primary mb-2"></i>
                                        <h6>Email Confirmation</h6>
                                        <p class="small">You will receive a confirmation email shortly.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card h-100">
                                    <div class="card-body text-center">
                                        <i class="fas fa-calendar-check fa-2x text-success mb-2"></i>
                                        <h6>Reservation Confirmed</h6>
                                        <p class="small">Your reservation is now confirmed and active.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card h-100">
                                    <div class="card-body text-center">
                                        <i class="fas fa-phone fa-2x text-warning mb-2"></i>
                                        <h6>Need Help?</h6>
                                        <p class="small">Contact us at +84 123 456 789 for assistance.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-center gap-3">
                        <a href="@Url.Action("Details", "Reservations", new { id = Model.ReservationID })" class="btn btn-primary">
                            <i class="fas fa-eye"></i> View Reservation
                        </a>
                        <a href="@Url.Action("Index", "Reservations")" class="btn btn-info">
                            <i class="fas fa-list"></i> My Reservations
                        </a>
                        <a href="@Url.Action("Index", "Home")" class="btn btn-secondary">
                            <i class="fas fa-home"></i> Back to Home
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        transition: transform 0.2s;
    }

    .card:hover {
        transform: translateY(-2px);
    }

    .fa-check-circle {
        animation: bounce 1s ease-in-out;
    }

    @@keyframes bounce {
        0%, 20%, 50%, 80%, 100% {
            transform: translateY(0);
        }
        40% {
            transform: translateY(-10px);
        }
        60% {
            transform: translateY(-5px);
        }
    }
</style>
