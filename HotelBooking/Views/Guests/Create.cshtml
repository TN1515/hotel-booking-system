@model HotelBooking.Models.Guest
@{
    ViewData["Title"] = "Create Guest";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="admin-content">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 mb-1 fw-bold">Create New Guest</h1>
            <p class="text-muted mb-0">Add a new guest profile to the system</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-2"></i>Back to Guests
        </a>
    </div>

    <!-- Create Form -->
    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-user-plus me-2"></i>Guest Information
                    </h5>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post" class="needs-validation" novalidate>
                        <!-- Personal Information -->
                        <h6 class="text-primary mb-3">
                            <i class="fas fa-user me-2"></i>Personal Information
                        </h6>
                        
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FirstName" class="form-label fw-bold">
                                    <i class="fas fa-user me-2"></i>First Name
                                </label>
                                <input asp-for="FirstName" class="form-control form-control-lg" placeholder="Enter first name" required />
                                <span asp-validation-for="FirstName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="LastName" class="form-label fw-bold">
                                    <i class="fas fa-user me-2"></i>Last Name
                                </label>
                                <input asp-for="LastName" class="form-control form-control-lg" placeholder="Enter last name" required />
                                <span asp-validation-for="LastName" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Email" class="form-label fw-bold">
                                    <i class="fas fa-envelope me-2"></i>Email Address
                                </label>
                                <input asp-for="Email" class="form-control form-control-lg" type="email" placeholder="Enter email address" required />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Phone" class="form-label fw-bold">
                                    <i class="fas fa-phone me-2"></i>Phone Number
                                </label>
                                <input asp-for="Phone" class="form-control form-control-lg" placeholder="Enter phone number" />
                                <span asp-validation-for="Phone" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="AgeGroup" class="form-label fw-bold">
                                    <i class="fas fa-users me-2"></i>Age Group
                                </label>
                                <select asp-for="AgeGroup" class="form-select form-select-lg">
                                    <option value="">Select age group</option>
                                    <option value="18-25">18-25 years</option>
                                    <option value="26-35">26-35 years</option>
                                    <option value="36-45">36-45 years</option>
                                    <option value="46-55">46-55 years</option>
                                    <option value="56-65">56-65 years</option>
                                    <option value="65+">65+ years</option>
                                </select>
                                <span asp-validation-for="AgeGroup" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="PhoneNumber" class="form-label fw-bold">
                                    <i class="fas fa-mobile-alt me-2"></i>Mobile Number
                                </label>
                                <input asp-for="PhoneNumber" class="form-control form-control-lg" placeholder="Enter mobile number" />
                                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                            </div>
                        </div>

                        <hr class="my-4">

                        <!-- Address Information -->
                        <h6 class="text-primary mb-3">
                            <i class="fas fa-map-marker-alt me-2"></i>Address Information
                        </h6>

                        <div class="mb-3">
                            <label asp-for="Address" class="form-label fw-bold">
                                <i class="fas fa-home me-2"></i>Street Address
                            </label>
                            <textarea asp-for="Address" class="form-control" rows="2" placeholder="Enter street address"></textarea>
                            <span asp-validation-for="Address" class="text-danger"></span>
                        </div>

                        <!-- City and Postal Code removed as not in Guest model -->

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="CountryID" class="form-label fw-bold">
                                    <i class="fas fa-globe me-2"></i>Country
                                </label>
                                <select asp-for="CountryID" class="form-select form-select-lg" id="countrySelect">
                                    <option value="">Select country</option>
                                    @if (ViewBag.Countries != null)
                                    {
                                        @foreach (var country in ViewBag.Countries)
                                        {
                                            <option value="@country.CountryID">@country.CountryName</option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="CountryID" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="StateID" class="form-label fw-bold">
                                    <i class="fas fa-map me-2"></i>State/Province
                                </label>
                                <select asp-for="StateID" class="form-select form-select-lg" id="stateSelect">
                                    <option value="">Select state</option>
                                </select>
                                <span asp-validation-for="StateID" class="text-danger"></span>
                            </div>
                        </div>

                        <hr class="my-4">

                        <!-- Additional Information -->
                        <h6 class="text-primary mb-3">
                            <i class="fas fa-info-circle me-2"></i>Additional Information
                        </h6>

                        <!-- Additional fields removed as not in Guest model -->

                        <!-- Action Buttons -->
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg me-md-2">
                                <i class="fas fa-times me-2"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="fas fa-save me-2"></i>Create Guest
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Help Panel -->
        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h6 class="mb-0">
                        <i class="fas fa-question-circle me-2"></i>Help & Guidelines
                    </h6>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2">
                            <i class="fas fa-check text-success me-2"></i>
                            <strong>Required:</strong> First name, last name, and email
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-info text-info me-2"></i>
                            Email must be unique in the system
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-shield-alt text-warning me-2"></i>
                            All personal data is encrypted and secure
                        </li>
                        <li class="mb-0">
                            <i class="fas fa-edit text-primary me-2"></i>
                            Guest information can be updated later
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="card shadow-sm mt-3">
                <div class="card-header bg-light">
                    <h6 class="mb-0">
                        <i class="fas fa-bolt me-2"></i>Quick Actions
                    </h6>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a asp-action="Index" class="btn btn-outline-primary btn-sm">
                            <i class="fas fa-list me-2"></i>View All Guests
                        </a>
                        <a asp-controller="Reservations" asp-action="Index" class="btn btn-outline-success btn-sm">
                            <i class="fas fa-calendar me-2"></i>View Reservations
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        $(document).ready(function() {
            // Country/State dropdown dependency
            $('#countrySelect').on('change', function() {
                const countryId = $(this).val();
                const stateSelect = $('#stateSelect');
                
                stateSelect.empty().append('<option value="">Loading...</option>');
                
                if (countryId) {
                    $.get('@Url.Action("GetStatesByCountry", "GuestProfile")', { countryId: countryId })
                        .done(function(states) {
                            stateSelect.empty().append('<option value="">Select state</option>');
                            $.each(states, function(index, state) {
                                stateSelect.append(`<option value="${state.stateID}">${state.stateName}</option>`);
                            });
                        })
                        .fail(function() {
                            stateSelect.empty().append('<option value="">Error loading states</option>');
                        });
                } else {
                    stateSelect.empty().append('<option value="">Select state</option>');
                }
            });
            
            // Form validation
            $('form').on('submit', function(e) {
                if (!this.checkValidity()) {
                    e.preventDefault();
                    e.stopPropagation();
                }
                $(this).addClass('was-validated');
            });
        });
    </script>
}
