@model HotelBooking.Models.Reservation
@{
    ViewData["Title"] = "Cancel Booking";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-danger text-white">
                    <h2 class="card-title mb-0">
                        <i class="fas fa-times-circle me-2"></i>Cancel Booking
                    </h2>
                </div>
                <div class="card-body p-4">
                    <!-- Warning Alert -->
                    <div class="alert alert-warning" role="alert">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <strong>Warning!</strong> You are about to cancel your booking. This action cannot be undone.
                    </div>

                    <!-- Booking Summary -->
                    <div class="card mb-4">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">
                                <i class="fas fa-info-circle me-2"></i>Booking Summary
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <dl class="row">
                                        <dt class="col-sm-5">Reservation ID:</dt>
                                        <dd class="col-sm-7">#@Model.ReservationID</dd>
                                        
                                        <dt class="col-sm-5">Room:</dt>
                                        <dd class="col-sm-7">@Model.Room?.RoomNumber - @Model.Room?.RoomType?.TypeName</dd>
                                        
                                        <dt class="col-sm-5">Check-in:</dt>
                                        <dd class="col-sm-7">@Model.CheckInDate.ToString("MMM dd, yyyy")</dd>
                                        
                                        <dt class="col-sm-5">Check-out:</dt>
                                        <dd class="col-sm-7">@Model.CheckOutDate.ToString("MMM dd, yyyy")</dd>
                                    </dl>
                                </div>
                                <div class="col-md-6">
                                    <dl class="row">
                                        <dt class="col-sm-5">Guests:</dt>
                                        <dd class="col-sm-7">@Model.NumberOfGuests</dd>
                                        
                                        <dt class="col-sm-5">Nights:</dt>
                                        <dd class="col-sm-7">@((Model.CheckOutDate - Model.CheckInDate).Days)</dd>
                                        
                                        <dt class="col-sm-5">Total Cost:</dt>
                                        <dd class="col-sm-7 text-success fw-bold">
                                            @(((Model.CheckOutDate - Model.CheckInDate).Days * (Model.Room?.Price ?? 0)).ToString("C"))
                                        </dd>
                                        
                                        <dt class="col-sm-5">Status:</dt>
                                        <dd class="col-sm-7">
                                            <span class="badge bg-success">@Model.Status</span>
                                        </dd>
                                    </dl>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Cancellation Policy -->
                    <div class="card mb-4">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">
                                <i class="fas fa-file-contract me-2"></i>Cancellation Policy
                            </h5>
                        </div>
                        <div class="card-body">
                            <ul class="list-unstyled">
                                <li class="mb-2">
                                    <i class="fas fa-check text-success me-2"></i>
                                    <strong>Free Cancellation:</strong> Cancel up to 24 hours before check-in for a full refund.
                                </li>
                                <li class="mb-2">
                                    <i class="fas fa-exclamation-triangle text-warning me-2"></i>
                                    <strong>Late Cancellation:</strong> Cancellations within 24 hours of check-in may incur a fee.
                                </li>
                                <li class="mb-2">
                                    <i class="fas fa-times text-danger me-2"></i>
                                    <strong>No-Show:</strong> No refund for no-shows.
                                </li>
                            </ul>
                            
                            @{
                                var hoursUntilCheckIn = (Model.CheckInDate - DateTime.Now).TotalHours;
                                var canCancelFree = hoursUntilCheckIn > 24;
                            }
                            
                            @if (canCancelFree)
                            {
                                <div class="alert alert-success">
                                    <i class="fas fa-check-circle me-2"></i>
                                    <strong>Good news!</strong> You can cancel this booking for free as it's more than 24 hours before check-in.
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-warning">
                                    <i class="fas fa-exclamation-triangle me-2"></i>
                                    <strong>Notice:</strong> This booking is within 24 hours of check-in. Cancellation fees may apply.
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Cancellation Form -->
                    <form asp-action="Cancel" method="post">
                        <input type="hidden" name="id" value="@Model.ReservationID" />
                        
                        <div class="mb-3">
                            <label for="cancellationReason" class="form-label fw-bold">
                                <i class="fas fa-comment me-2"></i>Reason for Cancellation (Optional)
                            </label>
                            <textarea name="cancellationReason" id="cancellationReason" class="form-control" rows="3" 
                                      placeholder="Please let us know why you're cancelling (optional)..."></textarea>
                        </div>

                        <!-- Confirmation Checkbox -->
                        <div class="form-check mb-4">
                            <input class="form-check-input" type="checkbox" id="confirmCancellation" required>
                            <label class="form-check-label fw-bold" for="confirmCancellation">
                                I understand that this action cannot be undone and I want to cancel this booking.
                            </label>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-action="Details" asp-route-id="@Model.ReservationID" class="btn btn-outline-secondary btn-lg me-md-2">
                                <i class="fas fa-arrow-left me-2"></i>Keep Booking
                            </a>
                            <button type="submit" class="btn btn-danger btn-lg" id="cancelButton" disabled>
                                <i class="fas fa-times me-2"></i>Cancel Booking
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Enable/disable cancel button based on checkbox
            $('#confirmCancellation').on('change', function() {
                $('#cancelButton').prop('disabled', !this.checked);
            });

            // Confirmation before submitting
            $('form').on('submit', function(e) {
                if (!confirm('Are you absolutely sure you want to cancel this booking? This action cannot be undone.')) {
                    e.preventDefault();
                    return false;
                }
            });
        });
    </script>
}
