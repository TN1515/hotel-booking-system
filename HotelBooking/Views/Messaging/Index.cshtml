@{
    ViewData["Title"] = "Messages";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
/* Reset và Base Styles */
.messenger-container {
    position: fixed;
    top: 80px;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    background: #fff;
    z-index: 1000;
}

/* Sidebar */
.messenger-sidebar {
    width: 360px;
    background: #fff;
    border-right: 1px solid #e4e6ea;
    display: flex;
    flex-direction: column;
    height: 100%;
}

.sidebar-header {
    padding: 20px;
    border-bottom: 1px solid #e4e6ea;
    background: #f8f9fa;
}

.search-container .input-group-text {
    border-radius: 20px 0 0 20px;
}

.search-container .form-control {
    border-radius: 0 20px 20px 0;
    padding-left: 0;
}

.search-container .form-control:focus {
    box-shadow: none;
    border-color: #e4e6ea;
}

/* Conversations List */
.conversations-list {
    flex: 1;
    overflow-y: auto;
    padding: 8px 0;
}

.conversation-item {
    display: flex;
    align-items: center;
    padding: 12px 20px;
    cursor: pointer;
    transition: all 0.2s ease;
    border-radius: 0;
    position: relative;
}

.conversation-item:hover {
    background-color: #f2f3f5;
}

.conversation-item.active {
    background-color: #e7f3ff;
    border-right: 3px solid #1877f2;
}

.conversation-avatar {
    position: relative;
    margin-right: 12px;
}

.avatar-circle {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    font-weight: 600;
    color: white;
    background: linear-gradient(135deg, #1877f2, #42a5f5);
}

.bg-gradient-primary {
    background: linear-gradient(135deg, #1877f2, #42a5f5) !important;
}

.online-indicator {
    position: absolute;
    bottom: 2px;
    right: 2px;
    width: 16px;
    height: 16px;
    background: #bcc0c4;
    border: 3px solid white;
    border-radius: 50%;
    transition: background-color 0.3s ease;
}

.online-indicator.active {
    background: #42b883;
}

.conversation-content {
    flex: 1;
    min-width: 0;
}

.conversation-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
}

.conversation-name {
    font-size: 15px;
    font-weight: 600;
    color: #1c1e21;
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.conversation-time {
    font-size: 13px;
    color: #65676b;
    white-space: nowrap;
}

.conversation-preview {
    display: flex;
    align-items: center;
    position: relative;
}

.message-sender {
    font-weight: 600;
    color: #65676b;
}

.message-text {
    font-size: 13px;
    color: #65676b;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    flex: 1;
}

.unread-badge {
    background: #1877f2;
    color: white;
    font-size: 12px;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 12px;
    margin-left: 8px;
    min-width: 20px;
    text-align: center;
}

/* Empty State */
.empty-conversations {
    text-align: center;
    padding: 60px 20px;
    color: #65676b;
}

.empty-icon i {
    font-size: 64px;
    color: #bcc0c4;
    margin-bottom: 16px;
}

.empty-conversations h5 {
    color: #1c1e21;
    margin-bottom: 8px;
}

.empty-conversations p {
    font-size: 14px;
    margin-bottom: 20px;
}

/* Chat Area */
.messenger-chat {
    flex: 1;
    display: flex;
    flex-direction: column;
    background: #fff;
    position: relative;
    height: 100%;
}

/* Welcome Screen */
.chat-welcome {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    background: linear-gradient(135deg, #f5f7fa, #e4e6ea);
}

.welcome-content {
    text-align: center;
    padding: 40px;
    max-width: 500px;
}

.welcome-icon {
    width: 80px;
    height: 80px;
    background: linear-gradient(135deg, #1877f2, #42a5f5);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 24px;
}

.welcome-icon i {
    font-size: 40px;
    color: white;
}

.welcome-content h3 {
    color: #1c1e21;
    margin-bottom: 12px;
}

.welcome-content p {
    color: #65676b;
    margin-bottom: 24px;
}

/* Chat Container */
.chat-container {
    display: flex;
    flex-direction: column;
    height: 100%;
}

/* Chat Header */
.chat-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 20px;
    border-bottom: 1px solid #e4e6ea;
    background: #f8f9fa;
}

.chat-user-info {
    display: flex;
    align-items: center;
}

.chat-avatar {
    position: relative;
    margin-right: 12px;
}

.chat-avatar .avatar-circle {
    width: 48px;
    height: 48px;
}

.chat-user-details {
    display: flex;
    flex-direction: column;
}

.chat-user-name {
    font-size: 16px;
    font-weight: 600;
    color: #1c1e21;
    margin: 0;
}

.chat-user-status {
    font-size: 13px;
    color: #65676b;
    transition: color 0.3s ease;
}

.chat-user-status.online {
    color: #42b883;
}

.chat-actions button {
    width: 36px;
    height: 36px;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
}

/* Messages Area */
.messages-area {
    flex: 1;
    overflow-y: auto;
    padding: 20px;
    background: #f0f2f5;
    display: flex;
    flex-direction: column;
}

/* Message Bubbles */
.message-bubble {
    max-width: 65%;
    padding: 12px 16px;
    border-radius: 18px;
    margin-bottom: 8px;
    position: relative;
    word-wrap: break-word;
}

.message-sent {
    align-self: flex-end;
    background: #1877f2;
    color: white;
    border-bottom-right-radius: 4px;
}

.message-received {
    align-self: flex-start;
    background: white;
    color: #1c1e21;
    border-bottom-left-radius: 4px;
}

.message-time {
    font-size: 11px;
    margin-top: 4px;
    text-align: right;
}

.message-sent .message-time {
    color: rgba(255, 255, 255, 0.7);
}

.message-received .message-time {
    color: #65676b;
}

/* Typing Indicator */
.typing-indicator {
    display: flex;
    align-items: center;
    padding: 8px 20px;
    color: #65676b;
    font-size: 13px;
}

.typing-dots {
    display: flex;
    margin-right: 8px;
}

.typing-dots span {
    width: 8px;
    height: 8px;
    background: #65676b;
    border-radius: 50%;
    margin-right: 4px;
    animation: typingAnimation 1.5s infinite ease-in-out;
}

.typing-dots span:nth-child(1) {
    animation-delay: 0s;
}

.typing-dots span:nth-child(2) {
    animation-delay: 0.3s;
}

.typing-dots span:nth-child(3) {
    animation-delay: 0.6s;
    margin-right: 0;
}

@@keyframes typingAnimation {
    0%, 100% {
        transform: translateY(0);
    }
    50% {
        transform: translateY(-5px);
    }
}

/* Message Input */
.message-input-container {
    padding: 12px 20px;
    border-top: 1px solid #e4e6ea;
    background: #f8f9fa;
}

.message-form {
    display: flex;
    align-items: center;
}

.input-actions {
    display: flex;
    margin-right: 8px;
}

.input-actions button {
    width: 36px;
    height: 36px;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
}

.message-input-wrapper {
    flex: 1;
    background: #f0f2f5;
    border-radius: 20px;
    padding: 0 16px;
}

.message-input {
    width: 100%;
    border: none;
    background: transparent;
    padding: 10px 0;
    outline: none;
    font-size: 15px;
}

.send-button {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #1877f2;
    color: white;
    border: none;
    margin-left: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
}

.send-button:hover {
    background: #166fe5;
}

.send-button:disabled {
    background: #bcc0c4;
    cursor: not-allowed;
}

/* Responsive */
@@media (max-width: 768px) {
    .messenger-container {
        top: 60px;
    }

    .messenger-sidebar {
        width: 100%;
        max-width: 400px;
    }
}
</style>

<!-- Messenger-style Layout -->
<div class="messenger-container">
    <!-- Sidebar -->
    <div class="messenger-sidebar">
        <!-- Sidebar Header -->
        <div class="sidebar-header">
            <div class="d-flex justify-content-between align-items-center">
                <h4 class="mb-0">
                    <i class="fab fa-facebook-messenger text-primary me-2"></i>
                    Messages
                </h4>
                <button class="btn btn-sm btn-outline-primary rounded-circle" onclick="showStaffList()" title="New Message">
                    <i class="fas fa-plus"></i>
                </button>
            </div>
            <!-- Search Bar -->
            <div class="search-container mt-3">
                <div class="input-group">
                    <span class="input-group-text bg-light border-0">
                        <i class="fas fa-search text-muted"></i>
                    </span>
                    <input type="text" class="form-control border-0 bg-light" placeholder="Search conversations..." id="searchInput">
                </div>
            </div>
        </div>

        <!-- Conversations List -->
        <div class="conversations-list" id="conversationsList">
            @if (ViewBag.Conversations != null && ((List<dynamic>)ViewBag.Conversations).Count > 0)
            {
                @foreach (var conversation in (List<dynamic>)ViewBag.Conversations)
                {
                    <div class="conversation-item" data-user-id="@conversation.UserId" onclick="loadChat(@conversation.UserId, '@conversation.UserName')">
                        <div class="conversation-avatar">
                            <div class="avatar-circle bg-gradient-primary">
                                <span>@conversation.UserName.Substring(0, 1).ToUpper()</span>
                            </div>
                            <div class="online-indicator active"></div>
                        </div>
                        <div class="conversation-content">
                            <div class="conversation-header">
                                <h6 class="conversation-name">@conversation.UserName</h6>
                                <span class="conversation-time">@conversation.LastMessageTime.ToString("HH:mm")</span>
                            </div>
                            <div class="conversation-preview">
                                @if (conversation.IsLastMessageFromMe)
                                {
                                    <span class="message-sender">You: </span>
                                }
                                <span class="message-text">@(conversation.LastMessage.Length > 35 ? conversation.LastMessage.Substring(0, 35) + "..." : conversation.LastMessage)</span>
                                @if (conversation.UnreadCount > 0)
                                {
                                    <span class="unread-badge">@conversation.UnreadCount</span>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="empty-conversations">
                    <div class="empty-icon">
                        <i class="fab fa-facebook-messenger"></i>
                    </div>
                    <h5>No conversations yet</h5>
                    <p>Start chatting with your team members</p>
                    <button class="btn btn-primary btn-sm" onclick="showStaffList()">
                        <i class="fas fa-plus me-1"></i>Start Conversation
                    </button>
                </div>
            }
        </div>
    </div>

    <!-- Chat Area -->
    <div class="messenger-chat">
        <!-- Welcome Screen -->
        <div class="chat-welcome" id="chatWelcome">
            <div class="welcome-content">
                <div class="welcome-icon">
                    <i class="fab fa-facebook-messenger"></i>
                </div>
                <h3>Welcome to Messages</h3>
                <p>Select a conversation from the sidebar to start chatting with your team members.</p>
                <button class="btn btn-primary" onclick="showStaffList()">
                    <i class="fas fa-plus me-2"></i>Start New Conversation
                </button>
            </div>
        </div>

        <!-- Chat Container (Hidden initially) -->
        <div class="chat-container" id="chatContainer" style="display: none;">
            <!-- Chat Header -->
            <div class="chat-header">
                <div class="chat-user-info">
                    <div class="chat-avatar">
                        <div class="avatar-circle bg-gradient-primary" id="chatUserAvatar">
                            <span id="chatUserInitial">U</span>
                        </div>
                        <div class="online-indicator active"></div>
                    </div>
                    <div class="chat-user-details">
                        <h5 class="chat-user-name" id="chatUserName">User Name</h5>
                        <span class="chat-user-status online">Active now</span>
                    </div>
                </div>
                <div class="chat-actions">
                    <button class="btn btn-sm btn-outline-secondary rounded-circle me-2" title="Call">
                        <i class="fas fa-phone"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-secondary rounded-circle me-2" title="Video Call">
                        <i class="fas fa-video"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-secondary rounded-circle" title="More Options">
                        <i class="fas fa-ellipsis-h"></i>
                    </button>
                </div>
            </div>

            <!-- Messages Area -->
            <div class="messages-area" id="messagesArea">
                <!-- Messages will be loaded here -->
            </div>

            <!-- Typing Indicator -->
            <div class="typing-indicator" id="typingIndicator" style="display: none;">
                <div class="typing-dots">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
                <span class="typing-text">Someone is typing...</span>
            </div>

            <!-- Message Input -->
            <div class="message-input-container">
                <form id="messageForm" class="message-form">
                    <input type="hidden" id="currentReceiverId" value="" />
                    <div class="input-actions">
                        <button type="button" class="btn btn-sm btn-outline-secondary rounded-circle me-2" title="Attach File">
                            <i class="fas fa-paperclip"></i>
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary rounded-circle me-2" title="Emoji">
                            <i class="fas fa-smile"></i>
                        </button>
                    </div>
                    <div class="message-input-wrapper">
                        <input type="text" id="messageInput" class="message-input" placeholder="Type a message..." maxlength="1000" />
                    </div>
                    <button type="submit" class="send-button" id="sendButton">
                        <i class="fas fa-paper-plane"></i>
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Staff List Modal -->
<div class="modal fade" id="staffListModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-users me-2"></i>Select Staff Member
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="staffListContainer">
                    <div class="text-center py-3">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="mt-2 text-muted">Loading staff members...</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://unpkg.com/@@microsoft/signalr@@latest/dist/browser/signalr.min.js"></script>
<script>
// Global variables
let currentChatUserId = null;
let currentChatUserName = null;
let lastMessageTime = null;
let messageCheckInterval = null;
let connection = null;
let typingTimer = null;
let isTyping = false;

$(document).ready(function() {
    // Initialize SignalR connection
    initializeSignalR();

    // Initialize search functionality
    $('#searchInput').on('input', function() {
        const searchTerm = $(this).val().toLowerCase();
        $('.conversation-item').each(function() {
            const userName = $(this).find('.conversation-name').text().toLowerCase();
            if (userName.includes(searchTerm)) {
                $(this).show();
            } else {
                $(this).hide();
            }
        });
    });

    // Handle message form submission
    $('#messageForm').on('submit', function(e) {
        e.preventDefault();
        sendMessage();
    });

    // Handle Enter key in message input
    $('#messageInput').on('keypress', function(e) {
        if (e.which === 13 && !e.shiftKey) {
            e.preventDefault();
            sendMessage();
        }
    });

    // Handle typing indicator
    $('#messageInput').on('input', function() {
        if (currentChatUserId) {
            if (!isTyping) {
                isTyping = true;
                if (connection && connection.state === signalR.HubConnectionState.Connected) {
                    connection.invoke("SendTypingIndicator", currentChatUserId, true);
                }
            }

            // Clear previous timer
            if (typingTimer) {
                clearTimeout(typingTimer);
            }

            // Set new timer
            typingTimer = setTimeout(function() {
                isTyping = false;
                if (connection && connection.state === signalR.HubConnectionState.Connected) {
                    connection.invoke("SendTypingIndicator", currentChatUserId, false);
                }
            }, 2000);
        }
    });

    // Auto-refresh conversations every 30 seconds (fallback if SignalR fails)
    setInterval(refreshConversations, 30000);
});

function showStaffList() {
    $('#staffListModal').modal('show');
    loadStaffList();
}

function loadStaffList() {
    $.get('/Messaging/StaffList')
        .done(function(response) {
            if (response.success) {
                let html = '';
                response.users.forEach(function(user) {
                    html += `
                        <div class="staff-item" onclick="startChat(${user.Id}, '${user.UserName}')">
                            <div class="d-flex align-items-center">
                                <div class="avatar-circle bg-gradient-primary me-3">
                                    <span>${user.UserName.charAt(0).toUpperCase()}</span>
                                </div>
                                <div>
                                    <h6 class="mb-1">${user.UserName}</h6>
                                    <small class="text-muted">${user.Email} • ${user.Role}</small>
                                </div>
                            </div>
                        </div>
                    `;
                });
                $('#staffListContainer').html(html);
            } else {
                $('#staffListContainer').html('<div class="alert alert-danger">Failed to load staff list</div>');
            }
        })
        .fail(function() {
            $('#staffListContainer').html('<div class="alert alert-danger">Error loading staff list</div>');
        });
}

function startChat(userId, userName) {
    $('#staffListModal').modal('hide');
    if (userId && userName) {
        loadChat(userId, userName);
    } else {
        console.error('Invalid userId or userName:', userId, userName);
    }
}

function loadChat(userId, userName) {
    // Update active conversation
    $('.conversation-item').removeClass('active');
    $(`.conversation-item[data-user-id="${userId}"]`).addClass('active');

    // Set current chat user
    currentChatUserId = userId;
    currentChatUserName = userName;

    // Update chat header
    $('#chatUserName').text(userName);
    $('#chatUserInitial').text(userName.charAt(0).toUpperCase());
    $('#currentReceiverId').val(userId);

    // Show chat container and hide welcome screen
    $('#chatWelcome').hide();
    $('#chatContainer').show();

    // Load messages
    loadMessages(userId);

    // Start message checking interval (fallback if SignalR fails)
    if (messageCheckInterval) {
        clearInterval(messageCheckInterval);
    }
    if (!connection || connection.state !== signalR.HubConnectionState.Connected) {
        messageCheckInterval = setInterval(() => checkForNewMessages(userId), 3000);
    }

    // Mark messages as read
    markAsRead(userId);
}

function loadMessages(userId) {
    $.get('/Messaging/GetMessages', { userId: userId })
        .done(function(response) {
            if (response.success) {
                displayMessages(response.messages);
                scrollToBottom();
                lastMessageTime = new Date();
            }
        })
        .fail(function() {
            $('#messagesArea').html('<div class="text-center text-muted py-4">Failed to load messages</div>');
        });
}

function displayMessages(messages) {
    let html = '';
    messages.forEach(function(message) {
        const isSent = message.isFromCurrentUser;
        const messageClass = isSent ? 'message-sent' : 'message-received';
        const timeStr = new Date(message.sentAt).toLocaleTimeString('en-US', {
            hour: '2-digit',
            minute: '2-digit',
            hour12: false
        });

        html += `
            <div class="message-bubble ${messageClass}">
                <div class="message-content">${escapeHtml(message.content)}</div>
                <div class="message-time">
                    ${timeStr}
                    ${isSent && message.isRead ? '<i class="fas fa-check-double ms-1"></i>' : ''}
                    ${isSent && !message.isRead ? '<i class="fas fa-check ms-1"></i>' : ''}
                </div>
            </div>
        `;
    });

    $('#messagesArea').html(html);
}

function initializeSignalR() {
    // Create connection
    connection = new signalR.HubConnectionBuilder()
        .withUrl("/chatHub")
        .withAutomaticReconnect()
        .build();

    // Handle received messages
    connection.on("ReceiveMessage", function(message) {
        if (currentChatUserId === message.senderId) {
            // Add message to chat if we're currently chatting with this user
            addMessageToChat(message, false);
            scrollToBottom();

            // Mark as read immediately
            if (connection && connection.state === signalR.HubConnectionState.Connected) {
                connection.invoke("MarkAsRead", message.senderId);
            } else {
                markAsRead(message.senderId);
            }
        }

        // Refresh conversations to update preview
        refreshConversations();
    });

    // Handle message sent confirmation
    connection.on("MessageSent", function(message) {
        // Update message status in UI if needed
    });

    // Handle messages read
    connection.on("MessagesRead", function(userId) {
        if (currentChatUserId === userId) {
            // Update read receipts in UI
            $('.message-sent .message-time i.fa-check').removeClass('fa-check').addClass('fa-check-double');
        }
    });

    // Handle typing indicator
    connection.on("TypingIndicator", function(data) {
        if (currentChatUserId === data.userId) {
            if (data.isTyping) {
                $('#typingIndicator').show();
                $('.typing-text').text(`${data.userName} is typing...`);
            } else {
                $('#typingIndicator').hide();
            }
        }
    });

    // Handle user online status
    connection.on("UserOnline", function(userId) {
        $(`.conversation-item[data-user-id="${userId}"] .online-indicator`).addClass('active');
        if (currentChatUserId === userId) {
            $('.chat-user-status').text('Active now').addClass('online');
        }
    });

    // Handle user offline status
    connection.on("UserOffline", function(userId) {
        $(`.conversation-item[data-user-id="${userId}"] .online-indicator`).removeClass('active');
        if (currentChatUserId === userId) {
            $('.chat-user-status').text('Offline').removeClass('online');
        }
    });

    // Start connection
    connection.start()
        .then(function() {
            console.log("SignalR Connected");
        })
        .catch(function(err) {
            console.error("SignalR Connection Error: ", err);
        });
}

function sendMessage() {
    const content = $('#messageInput').val().trim();
    if (!content || !currentChatUserId) return;

    const sendButton = $('#sendButton');
    const messageInput = $('#messageInput');

    // Disable form
    sendButton.prop('disabled', true);
    messageInput.prop('disabled', true);

    // Try to send via SignalR first
    if (connection && connection.state === signalR.HubConnectionState.Connected) {
        connection.invoke("SendMessage", currentChatUserId, content)
            .then(function() {
                // Clear input
                messageInput.val('');
                messageInput.focus();

                // Reset typing indicator
                isTyping = false;
                if (typingTimer) {
                    clearTimeout(typingTimer);
                }
                connection.invoke("SendTypingIndicator", currentChatUserId, false);
            })
            .catch(function(err) {
                console.error("SignalR Send Error: ", err);
                // Fallback to AJAX
                sendMessageViaAjax(content);
            })
            .finally(function() {
                // Re-enable form
                sendButton.prop('disabled', false);
                messageInput.prop('disabled', false);
            });
    } else {
        // Fallback to AJAX
        sendMessageViaAjax(content);
    }
}

function sendMessageViaAjax(content) {
    $.post('/Messaging/SendMessage', {
        receiverId: currentChatUserId,
        content: content
    })
    .done(function(response) {
        if (response.success) {
            // Clear input
            $('#messageInput').val('');

            // Add message to chat
            addMessageToChat(response.message, true);

            // Update last message time
            lastMessageTime = new Date();

            // Scroll to bottom
            scrollToBottom();

            // Refresh conversations to update preview
            refreshConversations();
        } else {
            alert('Failed to send message: ' + response.message);
        }
    })
    .fail(function() {
        alert('Error sending message. Please try again.');
    })
    .always(function() {
        // Re-enable form
        $('#sendButton').prop('disabled', false);
        $('#messageInput').prop('disabled', false).focus();
    });
}

function addMessageToChat(message, isSent) {
    const timeStr = new Date(message.sentAt || new Date()).toLocaleTimeString('en-US', {
        hour: '2-digit',
        minute: '2-digit',
        hour12: false
    });

    const messageHtml = `
        <div class="message-bubble ${isSent ? 'message-sent' : 'message-received'}">
            <div class="message-content">${escapeHtml(message.content)}</div>
            <div class="message-time">
                ${timeStr}
                ${isSent ? '<i class="fas fa-check ms-1"></i>' : ''}
            </div>
        </div>
    `;

    $('#messagesArea').append(messageHtml);
}

function checkForNewMessages(userId) {
    if (!lastMessageTime || !userId) return;

    $.get('/Messaging/GetMessages', {
        userId: userId,
        lastMessageTime: lastMessageTime.toISOString()
    })
    .done(function(response) {
        if (response.success && response.messages.length > 0) {
            response.messages.forEach(function(message) {
                addMessageToChat(message, message.isFromCurrentUser);
            });

            // Update last message time
            lastMessageTime = new Date();

            // Scroll to bottom
            scrollToBottom();

            // Mark new messages as read
            markAsRead(userId);

            // Refresh conversations
            refreshConversations();
        }
    });
}

function scrollToBottom() {
    const messagesArea = $('#messagesArea');
    messagesArea.scrollTop(messagesArea[0].scrollHeight);
}

function markAsRead(userId) {
    if (!userId) return;

    // Try SignalR first
    if (connection && connection.state === signalR.HubConnectionState.Connected) {
        connection.invoke("MarkAsRead", userId);
    } else {
        // Fallback to AJAX
        $.post('/Messaging/MarkAsRead', {
            senderId: userId
        });
    }
}

function refreshConversations() {
    // Reload conversations list without refreshing the page
    $.get('/Messaging')
        .done(function(html) {
            const newConversations = $(html).find('#conversationsList').html();
            $('#conversationsList').html(newConversations);

            // Restore active conversation
            if (currentChatUserId) {
                $(`.conversation-item[data-user-id="${currentChatUserId}"]`).addClass('active');
            }
        });
}

function escapeHtml(text) {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
}

// Handle page visibility change
document.addEventListener('visibilitychange', function() {
    if (!document.hidden && currentChatUserId) {
        markAsRead(currentChatUserId);

        // Reconnect SignalR if needed
        if (connection && connection.state !== signalR.HubConnectionState.Connected) {
            connection.start()
                .then(() => console.log("SignalR Reconnected"))
                .catch(err => console.error("SignalR Reconnection Error: ", err));
        }
    }
});

// Initialize when page loads
$(document).ready(function() {
    initializeSignalR();
    loadConversations();

    // Auto-load chat if chatUserId is provided
    @if (ViewBag.ChatUserId != null)
    {
        <text>
        var chatUserId = @ViewBag.ChatUserId;
        // Find user name from conversations or staff list
        setTimeout(function() {
            var conversation = $(`.conversation-item[data-user-id="${chatUserId}"]`);
            if (conversation.length > 0) {
                var userName = conversation.find('.conversation-name').text();
                loadChat(chatUserId, userName);
            } else {
                // Load from staff list if not in conversations
                loadStaffList().then(function() {
                    var staffMember = staffList.find(s => s.id == chatUserId);
                    if (staffMember) {
                        loadChat(chatUserId, staffMember.fullName);
                    }
                });
            }
        }, 500);
        </text>
    }

    // Auto-refresh conversations every 30 seconds
    setInterval(loadConversations, 30000);
});
</script>


