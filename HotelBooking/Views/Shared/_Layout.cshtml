                                            <i class="fas fa-bookmark me-2"></i>My Bookings
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="ServiceHistory" asp-action="Index">
                                            <i class="fas fa-history me-2"></i>Service History
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="ServiceHistory" asp-action="Loyalty">
                                            <i class="fas fa-star me-2"></i>Loyalty Points
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Customer" asp-action="Profile">
                                            <i class="fas fa-user-edit me-2"></i>My Profile
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Customer" asp-action="Feedback">
                                            <i class="fas fa-comment-dots me-2"></i>Give Feedback
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Customer" asp-action="Notifications">
                                            <i class="fas fa-bell me-2"></i>Notifications
                                        </a>
                                    </li>
                                }

                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                        <button type="submit" class="dropdown-item">
                                            <i class="fas fa-sign-out-alt me-2"></i>Logout
