<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HotelBooking</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/layout-responsive.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HotelBooking.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <style>
        /* Sticky Footer Layout */
        * {
            box-sizing: border-box;
        }

        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
        }

        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .main-content {
            flex: 1 0 auto;
        }

        .modern-footer {
            flex-shrink: 0;
            margin-top: 0 !important;
        }

        /* Reset any conflicting Bootstrap/custom styles */
        .pb-3 {
            padding-bottom: 0 !important;
        }

        .hotel-management-container {
            min-height: auto !important;
            height: auto !important;
        }

        /* Ensure proper spacing */
        .container, .container-fluid {
            padding-bottom: 0;
        }

        /* Notification Bell Styles */
        .notification-bell {
            transition: all 0.3s ease;
            border-radius: 50% !important;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 5px;
        }

        .notification-bell:hover {
            transform: scale(1.1);
            color: #007bff !important;
            background-color: rgba(0, 123, 255, 0.1) !important;
        }

        .notification-bell:focus {
            box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
            outline: none;
        }

        .notification-badge {
            animation: pulse 2s infinite;
            min-width: 18px;
            height: 18px;
            font-size: 0.65rem !important;
            line-height: 1;
            padding: 2px 4px;
        }

        @@keyframes pulse {
            0% {
                transform: scale(1);
            }
            50% {
                transform: scale(1.1);
            }
            100% {
                transform: scale(1);
            }
        }

        /* Fix dropdown positioning */
        .dropdown-menu {
            border: 1px solid rgba(0, 0, 0, 0.15);
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
            border-radius: 0.5rem;
            margin-top: 0.5rem;
        }

        .dropdown-menu.show {
            animation: fadeInDown 0.3s ease;
        }

        .dropdown-menu-end {
            right: 0;
            left: auto;
        }

        /* Notification dropdown specific styles */
        .dropdown .dropdown-menu {
            z-index: 1050;
            position: absolute;
        }

        .notification-item {
            padding: 0.75rem 1rem;
            border-bottom: 1px solid #f8f9fa;
            cursor: pointer;
            transition: background-color 0.2s ease;
        }

        .notification-item:hover {
            background-color: #f8f9fa;
        }

        .notification-item.unread {
            background-color: #fff3cd;
            border-left: 3px solid #ffc107;
        }

        @@keyframes fadeInDown {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .notification-item {
            transition: background-color 0.2s ease;
        }

        .notification-item:hover {
            background-color: #f8f9fa;
        }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>
    <header>
