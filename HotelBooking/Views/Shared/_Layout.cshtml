                        <a asp-controller="Home" asp-action="Index" class="nav-item-simple">
                            <i class="fas fa-home"></i>
                            <span>Home</span>
                        </a>
                        <a asp-controller="Rooms" asp-action="Index" class="nav-item-simple">
                            <i class="fas fa-bed"></i>
                            <span>Rooms</span>
                        </a>
