    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @if (User.Identity!.IsAuthenticated)
    {
        <script>
            $(document).ready(function() {
                // Load notification count and recent notifications
                loadNotificationCount();

                // Load notifications when dropdown is opened
                $('#notificationDropdown').on('show.bs.dropdown', function(e) {
                    console.log('Notification dropdown opening...');
                    loadRecentNotifications();
                });

                // Handle dropdown click manually if Bootstrap fails
                $('#notificationDropdown').on('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();

                    var dropdown = $(this).next('.dropdown-menu');
                    var isVisible = dropdown.hasClass('show');

                    // Close all other dropdowns
                    $('.dropdown-menu').removeClass('show');

                    if (!isVisible) {
                        dropdown.addClass('show');
                        loadRecentNotifications();
                    }
                });

                // Close dropdown when clicking outside
                $(document).on('click', function(e) {
                    if (!$(e.target).closest('.dropdown').length) {
                        $('.dropdown-menu').removeClass('show');
                    }
                });

                // Refresh notifications every 30 seconds
                setInterval(loadNotificationCount, 30000);
            });

            function loadNotificationCount() {
                $.ajax({
                    url: '@Url.Action("GetUnreadCount", "Notification")',
                    type: 'GET',
                    success: function(response) {
                        var count = response.count || 0;
                        var badge = $('.notification-badge');

                        if (count > 0) {
                            badge.text(count).show();
                        } else {
                            badge.hide();
                        }
                    },
                    error: function() {
                        console.log('Failed to load notification count');
                    }
                });
            }

            function loadRecentNotifications() {
                var listContainer = $('#notificationList');

                $.ajax({
                    url: '@Url.Action("GetRecent", "Notification")',
                    type: 'GET',
                    data: { count: 5 },
                    success: function(response) {
                        var notifications = response.notifications || [];
                        var html = '';

                        if (notifications.length === 0) {
                            html = `
                                <li class="text-center py-4">
                                    <i class="fas fa-bell-slash fa-2x text-muted mb-2"></i>
                                    <p class="mb-0 text-muted small">No notifications yet</p>
                                </li>
                            `;
                        } else {
                            notifications.forEach(function(notification) {
                                var icon = getNotificationIcon(notification.type);
                                var readClass = notification.isRead ? 'read' : 'unread';
                                var newBadge = notification.isRead ? '' : '<span class="badge bg-primary ms-2">New</span>';
                                var timeAgo = getTimeAgo(new Date(notification.createdDate));

                                html += `
                                    <li>
                                        <a class="dropdown-item notification-item ${readClass}" href="#" data-id="${notification.id}">
                                            <div class="d-flex">
                                                <div class="flex-shrink-0">
                                                    ${icon}
                                                </div>
                                                <div class="flex-grow-1">
                                                    <h6 class="mb-1">${notification.title}${newBadge}</h6>
                                                    <p class="mb-1 small text-muted">${truncateText(notification.message, 60)}</p>
                                                    <small class="text-muted">${timeAgo}</small>
                                                </div>
                                            </div>
                                        </a>
                                    </li>
                                `;

                                if (notifications.indexOf(notification) < notifications.length - 1) {
                                    html += '<li><hr class="dropdown-divider"></li>';
                                }
                            });
                        }

                        listContainer.html(html);

                        // Add click handlers for marking as read
                        $('.notification-item.unread').click(function(e) {
                            e.preventDefault();
                            var notificationId = $(this).data('id');
                            markNotificationAsRead(notificationId, $(this));
                        });
                    },
                    error: function() {
                        listContainer.html(`
                            <li class="text-center py-3">
                                <i class="fas fa-exclamation-triangle text-warning"></i>
                                <p class="mb-0 text-muted small">Failed to load notifications</p>
                            </li>
                        `);
                    }
                });
            }

            function getNotificationIcon(type) {
                switch(type?.toLowerCase()) {
                    case 'booking':
                        return '<i class="fas fa-calendar-check text-success me-2"></i>';
                    case 'payment':
                        return '<i class="fas fa-credit-card text-info me-2"></i>';
                    case 'system':
                        return '<i class="fas fa-cog text-secondary me-2"></i>';
                    case 'promotion':
                        return '<i class="fas fa-gift text-warning me-2"></i>';
                    default:
                        return '<i class="fas fa-bell text-primary me-2"></i>';
                }
            }

            function truncateText(text, maxLength) {
                if (text.length <= maxLength) return text;
                return text.substring(0, maxLength) + '...';
            }

            function getTimeAgo(dateTime) {
                var now = new Date();
                var timeSpan = now - dateTime;
                var minutes = Math.floor(timeSpan / (1000 * 60));
                var hours = Math.floor(timeSpan / (1000 * 60 * 60));
                var days = Math.floor(timeSpan / (1000 * 60 * 60 * 24));
                var weeks = Math.floor(days / 7);
                var months = Math.floor(days / 30);
                var years = Math.floor(days / 365);

                if (minutes < 1) return 'Just now';
                if (minutes < 60) return minutes + ' minutes ago';
                if (hours < 24) return hours + ' hours ago';
                if (days < 7) return days + ' days ago';
                if (weeks < 4) return weeks + ' weeks ago';
                if (months < 12) return months + ' months ago';
                return years + ' years ago';
            }

            function markNotificationAsRead(notificationId, element) {
                $.ajax({
                    url: '@Url.Action("MarkAsRead", "Notification")',
                    type: 'POST',
                    data: {
                        id: notificationId,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(response) {
                        if (response.success) {
                            element.removeClass('unread').addClass('read');
                            element.find('.badge.bg-primary').remove();
                            loadNotificationCount(); // Refresh count
                        }
                    },
                    error: function() {
                        console.log('Failed to mark notification as read');
                    }
                });
            }
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)

    <!-- AI Chat Bot -->
    <link rel="stylesheet" href="~/css/ai-chat.css" asp-append-version="true" />
    @await Html.PartialAsync("_AIChat")
    <script src="~/js/ai-chat.js" asp-append-version="true"></script>

    <!-- Messenger Widget -->
    @if (User.Identity.IsAuthenticated)
    {
        @await Html.PartialAsync("_MessengerWidget")
        <script src="~/js/messenger-widget.js" asp-append-version="true"></script>
    }
</body>
</html>
