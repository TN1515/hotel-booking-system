                        </a>
                        <a asp-controller="GuestProfile" asp-action="Index" class="nav-item-simple">
                            <i class="fas fa-users"></i>
                            <span>Guests</span>
                        </a>
                        <a asp-controller="Rooms" asp-action="Index" class="nav-item-simple">
                            <i class="fas fa-bed"></i>
                            <span>Rooms</span>
                        </a>
                        <a asp-controller="UserManagement" asp-action="Index" class="nav-item-simple">
                            <i class="fas fa-users-cog"></i>
                            <span>User Management</span>
                        </a>
                        <a asp-controller="Reservations" asp-action="Index" class="nav-item-simple">
                            <i class="fas fa-calendar-check"></i>
                            <span>All Reservations</span>
                        </a>
                        <div class="nav-item dropdown">
                            <a class="nav-item-simple dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="fas fa-cogs"></i>
                                <span>Management</span>
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="@Url.Action("Index", "FeedbackManagement")"><i class="fas fa-comments me-2"></i>Feedback</a></li>
                                <li><a class="dropdown-item" href="@Url.Action("Reports", "Admin")"><i class="fas fa-chart-bar me-2"></i>Reports</a></li>
                                <li><a class="dropdown-item" href="@Url.Action("Index", "Notification")"><i class="fas fa-bell me-2"></i>Notifications</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="@Url.Action("Index", "UserManagement")"><i class="fas fa-user-cog me-2"></i>Users</a></li>
                                <li><a class="dropdown-item" href="@Url.Action("Index", "Amenities")"><i class="fas fa-spa me-2"></i>Amenities</a></li>
                                <li><a class="dropdown-item" href="@Url.Action("Index", "Settings")"><i class="fas fa-cog me-2"></i>Settings</a></li>
                            </ul>
