<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HotelBooking Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HotelBooking.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <style>
        .admin-body {
            background-color: #f8f9fa;
        }
        .admin-nav-link {
            color: #495057 !important;
            font-weight: 500;
            border-radius: 8px;
            transition: all 0.3s ease;
            white-space: nowrap;
        }
        .admin-nav-link:hover, .admin-nav-link.active {
            background-color: #e9ecef;
            color: #007bff !important;
        }
        .user-initial {
            width: 32px;
            height: 32px;
            font-size: 14px;
            font-weight: bold;
        }
        .notification-badge {
            position: relative;
        }
        .navbar-nav {
            flex-wrap: wrap;
        }
        .dropdown-menu {
            border: none;
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
        }
        .dropdown-item {
            padding: 0.5rem 1rem;
            transition: all 0.2s ease;
        }
        .dropdown-item:hover {
            background-color: #f8f9fa;
            color: #007bff;
        }

        /* Admin Notification Bell Styles */
        .notification-bell {
            transition: all 0.3s ease;
        }

        .notification-bell:hover {
            color: #007bff !important;
            transform: scale(1.05);
        }

        .admin-notification-badge {
            animation: pulse 2s infinite;
            min-width: 18px;
            height: 18px;
            line-height: 1;
            padding: 2px 4px;
            font-size: 0.7rem;
        }

        @@keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.1); }
            100% { transform: scale(1); }
        }



        .notification-item {
            padding: 0.75rem 1rem;
            border-bottom: 1px solid #f8f9fa;
            cursor: pointer;
            transition: background-color 0.2s ease;
        }

        .notification-item:hover {
            background-color: #f8f9fa;
        }

        .notification-item.unread {
            background-color: #fff3cd;
            border-left: 3px solid #ffc107;
        }

        /* Dropdown menu improvements */
        .dropdown-menu {
            z-index: 1050 !important;
            border: 1px solid rgba(0,0,0,.15) !important;
            box-shadow: 0 6px 12px rgba(0,0,0,.175) !important;
            position: absolute !important;
            top: 100% !important;
            right: 0 !important;
            left: auto !important;
        }

        .dropdown-menu.show {
            display: block !important;
            opacity: 1 !important;
            visibility: visible !important;
        }

        .dropdown {
            position: relative !important;
        }

        /* Ensure notification dropdown is visible */
        #adminNotificationDropdown + .dropdown-menu {
            min-width: 380px !important;
            margin-top: 5px !important;
        }

        /* Admin profile dropdown positioning - FORCE OVERRIDE */
        #userDropdown + .dropdown-menu,
        .nav-item.dropdown:last-child .dropdown-menu,
        .dropdown-menu.dropdown-menu-end {
            position: absolute !important;
            top: calc(100% + 15px) !important;
            right: 25px !important;
            left: auto !important;
            margin-top: 15px !important;
            margin-right: 25px !important;
            min-width: 220px !important;
            transform: translateX(-25px) translateY(5px) !important;
            z-index: 1060 !important;
        }

        /* Force admin dropdown positioning */
        .navbar-nav .nav-item.dropdown:last-child {
            margin-right: 25px !important;
            position: relative !important;
        }

        /* Additional override for admin profile */
        .navbar-nav .dropdown:last-child .dropdown-menu {
            right: 25px !important;
            left: auto !important;
            margin-top: 15px !important;
            transform: translateX(-25px) !important;
        }

        /* Navigation Styles - Same as Home Layout */
        .nav-item-simple {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-decoration: none;
            color: #6c757d;
            padding: 8px 12px;
            border-radius: 6px;
            transition: all 0.3s ease;
            font-size: 0.85rem;
            min-width: 70px;
        }

        .nav-item-simple:hover {
            color: #007bff;
            background-color: #e7f3ff;
            text-decoration: none;
        }

        .nav-item-simple i {
            font-size: 1.1rem;
            margin-bottom: 4px;
        }

        .nav-item-simple span {
            font-weight: 500;
            white-space: nowrap;
        }

        /* Dropdown Navigation */
        .nav-item.dropdown .nav-item-simple {
            cursor: pointer;
        }

        .nav-item.dropdown .dropdown-menu {
            border: none;
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
            border-radius: 8px;
            margin-top: 8px;
        }

        .nav-item.dropdown .dropdown-item {
            padding: 0.5rem 1rem;
            transition: all 0.2s ease;
            border-radius: 4px;
            margin: 2px 4px;
        }

        .nav-item.dropdown .dropdown-item:hover {
            background-color: #e7f3ff;
            color: #007bff;
        }

        /* Active navigation state */
        .nav-item-simple.active {
            background-color: #007bff;
            color: white !important;
        }

        .nav-item-simple.active:hover {
            background-color: #0056b3;
            color: white !important;
        }

        /* Notification Bell Styles */
        .notification-bell {
            transition: all 0.3s ease;
            border-radius: 50% !important;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 5px;
        }

        .notification-bell:hover {
            transform: scale(1.1);
            color: #007bff !important;
            background-color: rgba(0, 123, 255, 0.1) !important;
        }

        .notification-bell:focus {
            box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
            outline: none;
        }

        .notification-badge {
            animation: pulse 2s infinite;
            min-width: 18px;
            height: 18px;
            font-size: 0.65rem !important;
            line-height: 1;
            padding: 2px 4px;
        }

        @@keyframes pulse {
            0% {
                transform: scale(1);
            }
            50% {
                transform: scale(1.1);
            }
            100% {
                transform: scale(1);
            }
        }

        /* Body Layout Styles - Same as Home Layout */
        * {
            box-sizing: border-box;
        }

        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
        }

        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .main-content {
            flex: 1 0 auto;
        }

        .modern-footer {
            flex-shrink: 0;
            margin-top: 0 !important;
        }

        /* Footer Styles */
        .modern-footer {
            background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%);
            color: #ecf0f1;
            margin-top: 50px;
        }

        .footer-main {
            padding: 40px 0 20px;
        }

        .footer-brand .footer-title {
            color: #3498db;
            font-size: 1.5rem;
            margin-bottom: 15px;
            font-weight: 700;
        }

        .footer-description {
            color: #bdc3c7;
            font-size: 0.9rem;
            line-height: 1.6;
            margin-bottom: 0;
        }

        .footer-links-simple a {
            color: #bdc3c7;
            text-decoration: none;
            font-size: 0.9rem;
            transition: color 0.3s ease;
        }

        .footer-links-simple a:hover {
            color: #3498db;
        }

        .social-links-simple {
            display: flex;
            gap: 10px;
            margin-top: 15px;
        }

        .social-link {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 35px;
            height: 35px;
            background: rgba(52, 152, 219, 0.1);
            color: #3498db;
            border-radius: 50%;
            text-decoration: none;
            transition: all 0.3s ease;
            font-size: 0.9rem;
        }

        .social-link:hover {
            background: #3498db;
            color: white;
            transform: translateY(-2px);
        }

        .footer-bottom {
            background: rgba(0, 0, 0, 0.2);
            padding: 20px 0;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
        }

        .copyright {
            color: #bdc3c7;
            font-size: 0.9rem;
        }

        .footer-bottom-links {
            display: flex;
            gap: 20px;
            justify-content: flex-end;
        }

        .footer-bottom-links a {
            color: #bdc3c7;
            text-decoration: none;
            font-size: 0.9rem;
            transition: color 0.3s ease;
        }

        .footer-bottom-links a:hover {
            color: #3498db;
        }

        /* Admin Content Styles */
        .admin-content {
            padding: 20px;
            min-height: calc(100vh - 200px);
        }

        /* Consistent container styling for admin pages */
        .container-fluid {
            padding: 20px;
        }

        /* Card styling consistency */
        .card {
            border: none;
            box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
            border-radius: 0.5rem;
        }

        .card-header {
            background-color: #f8f9fa;
            border-bottom: 1px solid #dee2e6;
            border-radius: 0.5rem 0.5rem 0 0 !important;
            padding: 1rem 1.25rem;
        }

        .card-title {
            margin-bottom: 0;
            font-weight: 600;
            color: #495057;
        }

        /* Responsive Design */
        @@media (max-width: 768px) {
            .nav-item-simple span {
                display: none;
            }

            .nav-item-simple {
                min-width: 50px;
                padding: 8px;
            }

            .nav-item-simple i {
                margin-bottom: 0;
                font-size: 1.2rem;
            }

            .admin-content {
                padding: 10px;
            }

            .container-fluid {
                padding: 10px;
            }
        }

        @@media (max-width: 576px) {
            .nav-item-simple {
                min-width: 40px;
                padding: 6px;
            }

            .nav-item-simple i {
                font-size: 1rem;
            }
        }

        /* Breadcrumb Styles */
        .breadcrumb {
            background-color: transparent;
            padding: 0.5rem 0;
            margin-bottom: 1rem;
            font-size: 0.9rem;
        }

        .breadcrumb-item + .breadcrumb-item::before {
            content: ">";
            color: #6c757d;
        }

        .breadcrumb-item a {
            color: #007bff;
            transition: color 0.2s ease;
        }

        .breadcrumb-item a:hover {
            color: #0056b3;
        }

        .breadcrumb-item.active {
            color: #6c757d;
        }

    </style>
</head>
<body>
    <!-- Admin Header - Using same style as Home layout -->
    <header>
        <div style="background: #f8f9fa; border-bottom: 1px solid #dee2e6; padding: 15px 0;">
            <div style="display: flex; align-items: center; justify-content: space-between; max-width: 1200px; margin: 0 auto; padding: 0 20px;">
                <!-- Brand -->
                <div>
                    <a asp-controller="Home" asp-action="Index" style="text-decoration: none; color: #007bff; font-size: 1.5rem; font-weight: bold;">
                        <i class="fas fa-building me-2"></i>HotelBooking
                    </a>
                </div>

                <!-- Navigation Items -->
                <div style="display: flex; gap: 20px;">
                    @{
                        var controller = ViewContext.RouteData.Values["controller"]?.ToString();
                        var action = ViewContext.RouteData.Values["action"]?.ToString();
                    }
                    <!-- ADMIN NAVIGATION -->
                    <a asp-controller="Admin" asp-action="Dashboard" class="nav-item-simple @(controller == "Admin" && action == "Dashboard" ? "active" : "")">
                        <i class="fas fa-tachometer-alt"></i>
                        <span>Admin Dashboard</span>
                    </a>
                    <a asp-controller="GuestProfile" asp-action="Index" class="nav-item-simple @(controller == "GuestProfile" ? "active" : "")">
                        <i class="fas fa-users"></i>
                        <span>Guests</span>
                    </a>
                    <a asp-controller="Rooms" asp-action="Index" class="nav-item-simple @(controller == "Rooms" ? "active" : "")">
                        <i class="fas fa-bed"></i>
                        <span>Rooms</span>
                    </a>
                    <a asp-controller="UserManagement" asp-action="Index" class="nav-item-simple @(controller == "UserManagement" ? "active" : "")">
                        <i class="fas fa-users-cog"></i>
                        <span>User Management</span>
                    </a>
                    <a asp-controller="Reservations" asp-action="Index" class="nav-item-simple @(controller == "Reservations" || (controller == "Admin" && (action == "Reservations" || action == "ReservationDetails")) ? "active" : "")">
                        <i class="fas fa-calendar-check"></i>
                        <span>All Reservations</span>
                    </a>
                    <div class="nav-item dropdown">
                        @{
                            var isManagementActive = controller == "FeedbackManagement" || controller == "Report" || controller == "Notification" || controller == "Amenities" || controller == "Settings";
                        }
                        <a class="nav-item-simple dropdown-toggle @(isManagementActive ? "active" : "")" href="#" role="button" data-bs-toggle="dropdown">
                            <i class="fas fa-cogs"></i>
                            <span>Management</span>
                        </a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="@Url.Action("Index", "FeedbackManagement")"><i class="fas fa-comments me-2"></i>Feedback</a></li>
                            <li><a class="dropdown-item" href="@Url.Action("Index", "Report")"><i class="fas fa-chart-bar me-2"></i>Reports</a></li>
                            <li><a class="dropdown-item" href="@Url.Action("Index", "Notification")"><i class="fas fa-bell me-2"></i>Notifications</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="@Url.Action("Index", "UserManagement")"><i class="fas fa-user-cog me-2"></i>Users</a></li>
                            <li><a class="dropdown-item" href="@Url.Action("Index", "Amenities")"><i class="fas fa-spa me-2"></i>Amenities</a></li>
                            <li><a class="dropdown-item" href="@Url.Action("Index", "Settings")"><i class="fas fa-cog me-2"></i>Settings</a></li>
                        </ul>
                    </div>

                <!-- User Actions -->
                <div style="display: flex; align-items: center; gap: 15px;">
                    @if (User.Identity!.IsAuthenticated)
                    {
                        <!-- Notification Bell -->
                        <div class="dropdown">
                            <button class="btn notification-bell" type="button" id="adminNotificationDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fas fa-bell"></i>
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger admin-notification-badge" style="display: none;">0</span>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end" id="adminNotificationMenu" style="width: 350px; max-height: 450px; overflow-y: auto;">
                                <div class="dropdown-header"><i class="fas fa-bell me-2"></i>Recent Notifications</div>
                                <div class="dropdown-divider"></div>
                                <div id="adminNotificationList">
                                    <div class="text-center py-3">
                                        <div class="spinner-border spinner-border-sm text-primary" role="status">
                                            <span class="visually-hidden">Loading...</span>
                                        </div>
                                        <p class="mb-0 mt-2 text-muted small">Loading notifications...</p>
                                    </div>
                                </div>
                                <div class="dropdown-divider"></div>
                                <div class="text-center">
                                    <a class="dropdown-item text-center" asp-controller="Notification" asp-action="My">
                                        <i class="fas fa-eye me-2"></i>View All Notifications
                                    </a>
                                </div>
                            </div>
                        </div>

                        <!-- User Menu -->
                        <div class="dropdown">
                            <a class="nav-item-simple dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <div style="width: 32px; height: 32px; background: #28a745; color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 600; font-size: 14px;">
                                        @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "A")
                                    </div>
                                    <div style="display: flex; flex-direction: column; align-items: flex-start;">
                                        <span style="font-weight: 600; font-size: 14px;">@User.Identity?.Name</span>
                                        <small style="color: #28a745; font-size: 12px;">Admin</small>
                                    </div>
                                </div>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="@Url.Action("Profile", "Admin")"><i class="fas fa-user me-2"></i>Profile</a></li>
                                <li><a class="dropdown-item" href="@Url.Action("Index", "Settings")"><i class="fas fa-cog me-2"></i>Settings</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                        <button type="submit" class="dropdown-item">
                                            <i class="fas fa-sign-out-alt me-2"></i>Logout
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <div class="main-content">
        <div class="container-fluid">
            <!-- Breadcrumb -->
            @{
                var controllerName = ViewContext.RouteData.Values["controller"]?.ToString();
                var actionName = ViewContext.RouteData.Values["action"]?.ToString();
                var pageTitle = ViewData["Title"]?.ToString() ?? "Admin";
            }
            @if (controllerName != "Admin" || actionName != "Dashboard")
            {
                <nav aria-label="breadcrumb" class="mb-3">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a asp-controller="Admin" asp-action="Dashboard" class="text-decoration-none">
                                <i class="fas fa-home me-1"></i>Dashboard
                            </a>
                        </li>
                        <li class="breadcrumb-item active" aria-current="page">@pageTitle</li>
                    </ol>
                </nav>
            }
            @RenderBody()
        </div>
    </div>

    <!-- Footer -->
    <footer class="modern-footer">
        <div class="footer-main">
            <div class="container">
                <div class="row">
                    <div class="col-md-3">
                        <div class="footer-brand">
                            <h5 class="footer-title">
                                <i class="fas fa-building me-2"></i>HotelBooking
                            </h5>
                            <p class="footer-description">
                                Professional hotel booking system for modern hospitality.
                            </p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="footer-links-simple">
                            <h6 style="color: #3498db; margin-bottom: 15px; font-weight: 600;">Admin Links</h6>
                            <div style="display: flex; flex-direction: column; gap: 8px;">
                                <a asp-controller="Admin" asp-action="Dashboard">Dashboard</a>
                                <a asp-controller="Rooms" asp-action="Index">Rooms</a>
                                <a asp-controller="Reservations" asp-action="Index">Reservations</a>
                                <a asp-controller="GuestProfile" asp-action="Index">Guests</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <h6 style="color: #3498db; margin-bottom: 15px; font-weight: 600;">Contact Us</h6>
                        <div style="display: flex; flex-direction: column; gap: 8px;">
                            <div style="display: flex; align-items: center;">
                                <i class="fas fa-envelope me-2" style="color: #3498db; width: 20px;"></i>
                                <a href="mailto:Hotelbooking@gmail.com" style="color: #bdc3c7; text-decoration: none; font-size: 0.9rem;">
                                    Hotelbooking@gmail.com
                                </a>
                            </div>
                            <div style="display: flex; align-items: center;">
                                <i class="fas fa-phone me-2" style="color: #3498db; width: 20px;"></i>
                                <a href="tel:+84868686899" style="color: #bdc3c7; text-decoration: none; font-size: 0.9rem;">
                                    +84 868 686 899
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <h6 style="color: #3498db; margin-bottom: 15px; font-weight: 600;">About Us</h6>
                        <p style="color: #bdc3c7; font-size: 0.85rem; line-height: 1.5; margin-bottom: 10px;">
                            Your trusted partner in hospitality management, providing innovative booking solutions worldwide.
                        </p>
                        <div class="social-links-simple">
                            <a href="#" class="social-link"><i class="fab fa-facebook-f"></i></a>
                            <a href="#" class="social-link"><i class="fab fa-twitter"></i></a>
                            <a href="#" class="social-link"><i class="fab fa-instagram"></i></a>
                            <a href="#" class="social-link"><i class="fab fa-linkedin-in"></i></a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Footer Bottom -->
        <div class="footer-bottom">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-md-6">
                        <div class="copyright">
                            <i class="fas fa-copyright me-2"></i>
                            2025 <strong>HotelBooking</strong>. All rights reserved.
                        </div>
                    </div>
                    <div class="col-md-6 text-end">
                        <div class="footer-bottom-links">
                            <a asp-controller="Home" asp-action="Privacy">Privacy</a>
                            <a href="#">Terms</a>
                            <a href="#">Support</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <!-- CSRF Token for AJAX requests -->
    <form style="display: none;">
        @Html.AntiForgeryToken()
    </form>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @if (User.Identity!.IsAuthenticated)
    {
        <script>
            $(document).ready(function() {
                console.log('=== ADMIN NOTIFICATION SYSTEM INITIALIZING ===');
                console.log('jQuery version:', $.fn.jquery);
                console.log('User authenticated:', '@User.Identity!.IsAuthenticated');
                console.log('User name:', '@User.Identity?.Name');

                // Check if elements exist
                var $bellButton = $('#adminNotificationDropdown');
                var $menu = $('#adminNotificationMenu');
                var $list = $('#adminNotificationList');

                console.log('Notification bell button:', $bellButton.length);
                console.log('Notification menu element:', $menu.length);
                console.log('Notification list element:', $list.length);

                // Load notification count and recent notifications for admin
                loadAdminNotificationCount();

                // Add click event listener to notification bell
                $bellButton.on('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    console.log('🔔 NOTIFICATION BELL CLICKED via EVENT LISTENER!');

                    var isVisible = $menu.is(':visible');
                    console.log('Menu currently visible:', isVisible);

                    // Close all other dropdowns first
                    $('.dropdown-menu').hide();

                    if (!isVisible) {
                        console.log('📂 Opening notification dropdown...');
                        $menu.show();
                        loadAdminRecentNotifications();
                    } else {
                        console.log('📁 Closing notification dropdown...');
                        $menu.hide();
                    }
                });

                // Close dropdown when clicking outside
                $(document).on('click', function(e) {
                    if (!$(e.target).closest('.dropdown').length) {
                        $menu.hide();
                        console.log('Closed dropdown by clicking outside');
                    }
                });

                // Refresh notifications every 30 seconds
                setInterval(loadAdminNotificationCount, 30000);

                console.log('=== ADMIN NOTIFICATION SYSTEM INITIALIZED ===');
            });



            function loadAdminNotificationCount() {
                console.log('=== LOADING ADMIN NOTIFICATION COUNT ===');
                console.log('URL:', '@Url.Action("GetUnreadCount", "Notification")');

                $.ajax({
                    url: '@Url.Action("GetUnreadCount", "Notification")',
                    type: 'GET',
                    beforeSend: function() {
                        console.log('Sending AJAX request for notification count...');
                    },
                    success: function(response) {
                        console.log('✅ Admin notification count SUCCESS:', response);
                        var count = response.count || 0;
                        var badge = $('.admin-notification-badge');
                        console.log('Badge element found:', badge.length);

                        if (count > 0) {
                            badge.text(count).show();
                            console.log('✅ Badge shown with count:', count);
                        } else {
                            badge.hide();
                            console.log('ℹ️ Badge hidden (no notifications)');
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('❌ FAILED to load admin notification count');
                        console.error('Status:', status);
                        console.error('Error:', error);
                        console.error('Response:', xhr.responseText);
                        console.error('Status Code:', xhr.status);
                    }
                });
            }

            function loadAdminRecentNotifications() {
                console.log('=== LOADING ADMIN RECENT NOTIFICATIONS ===');
                var listContainer = $('#adminNotificationList');
                console.log('List container found:', listContainer.length);
                console.log('URL:', '@Url.Action("GetRecent", "Notification")');

                $.ajax({
                    url: '@Url.Action("GetRecent", "Notification")',
                    type: 'GET',
                    data: { count: 5 },
                    beforeSend: function() {
                        console.log('Sending AJAX request for recent notifications...');
                    },
                    success: function(response) {
                        console.log('✅ Admin recent notifications SUCCESS:', response);
                        var notifications = response.notifications || [];
                        console.log('Number of notifications:', notifications.length);
                        var html = '';

                        if (notifications.length === 0) {
                            html = `
                                <li class="text-center py-4">
                                    <i class="fas fa-bell-slash fa-2x text-muted mb-2"></i>
                                    <p class="mb-0 text-muted small">No notifications yet</p>
                                </li>
                            `;
                            console.log('ℹ️ No notifications found, showing empty state');
                        } else {
                            console.log('✅ Processing', notifications.length, 'notifications');
                            notifications.forEach(function(notification, index) {
                                console.log(`Processing notification ${index + 1}:`, notification);
                                var icon = getNotificationIcon(notification.type);
                                var readClass = notification.isRead ? 'read' : 'unread';
                                var newBadge = notification.isRead ? '' : '<span class="badge bg-primary ms-2">New</span>';
                                var timeAgo = getTimeAgo(new Date(notification.createdDate));

                                html += `
                                    <li class="notification-item ${readClass}" data-id="${notification.id}">
                                        <div class="d-flex">
                                            <div class="me-3">${icon}</div>
                                            <div class="flex-grow-1">
                                                <h6 class="mb-1 fw-semibold">${truncateText(notification.title, 30)}</h6>
                                                <p class="mb-1 small text-muted">${truncateText(notification.message, 60)}</p>
                                                <small class="text-muted">${timeAgo}</small>
                                                ${newBadge}
                                            </div>
                                        </div>
                                    </li>
                                `;
                            });
                            console.log('✅ Generated HTML for notifications');
                        }

                        console.log('✅ Setting HTML content to list container');
                        listContainer.html(html);
                        console.log('✅ HTML content set successfully');

                        // Add click handlers for marking as read
                        var unreadItems = $('.notification-item.unread');
                        console.log('Found', unreadItems.length, 'unread notification items');

                        unreadItems.click(function(e) {
                            e.preventDefault();
                            var notificationId = $(this).data('id');
                            console.log('Marking notification as read:', notificationId);
                            markNotificationAsRead(notificationId, $(this));
                        });

                        console.log('✅ Click handlers attached successfully');
                    },
                    error: function(xhr, status, error) {
                        console.error('❌ FAILED to load admin recent notifications');
                        console.error('Status:', status);
                        console.error('Error:', error);
                        console.error('Response:', xhr.responseText);
                        console.error('Status Code:', xhr.status);

                        listContainer.html(`
                            <li class="text-center py-3">
                                <i class="fas fa-exclamation-triangle text-warning"></i>
                                <p class="mb-0 text-muted small">Failed to load notifications</p>
                                <small class="text-danger">Error: ${error}</small>
                            </li>
                        `);
                    }
                });
            }

            function getNotificationIcon(type) {
                switch(type?.toLowerCase()) {
                    case 'booking':
                        return '<i class="fas fa-calendar-check text-success me-2"></i>';
                    case 'payment':
                        return '<i class="fas fa-credit-card text-info me-2"></i>';
                    case 'system':
                        return '<i class="fas fa-cog text-secondary me-2"></i>';
                    case 'promotion':
                        return '<i class="fas fa-gift text-warning me-2"></i>';
                    default:
                        return '<i class="fas fa-bell text-primary me-2"></i>';
                }
            }

            function truncateText(text, maxLength) {
                if (text.length <= maxLength) return text;
                return text.substring(0, maxLength) + '...';
            }

            function getTimeAgo(date) {
                var now = new Date();
                var diffMs = now - date;
                var diffMins = Math.floor(diffMs / 60000);
                var diffHours = Math.floor(diffMins / 60);
                var diffDays = Math.floor(diffHours / 24);

                if (diffMins < 1) return 'Just now';
                if (diffMins < 60) return diffMins + ' minutes ago';
                if (diffHours < 24) return diffHours + ' hours ago';
                if (diffDays < 7) return diffDays + ' days ago';
                return date.toLocaleDateString();
            }

            function markNotificationAsRead(notificationId, element) {
                $.ajax({
                    url: '@Url.Action("MarkAsRead", "Notification")',
                    type: 'POST',
                    data: {
                        id: notificationId,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(response) {
                        if (response.success) {
                            element.removeClass('unread').addClass('read');
                            element.find('.badge.bg-primary').remove();
                            loadAdminNotificationCount(); // Refresh count
                        }
                    },
                    error: function() {
                        console.log('Failed to mark notification as read');
                    }
                });
            }

            function testAdminNotifications() {
                console.log('Testing admin notifications...');

                // First test if we can get notification count
                $.ajax({
                    url: '@Url.Action("GetUnreadCount", "Notification")',
                    type: 'GET',
                    success: function(response) {
                        console.log('Current notification count:', response);

                        // Then create sample notifications
                        $.ajax({
                            url: '@Url.Action("SeedSampleNotifications", "Notification")',
                            type: 'GET',
                            success: function(response) {
                                console.log('Sample notifications created:', response);
                                loadAdminNotificationCount();
                                alert('Test notifications created! Check the notification bell.');
                            },
                            error: function(xhr, status, error) {
                                console.log('Failed to create test notifications:', error);
                                console.log('Response:', xhr.responseText);
                                alert('Failed to create test notifications. Check console for details.');
                            }
                        });
                    },
                    error: function(xhr, status, error) {
                        console.log('Failed to get notification count:', error);
                        console.log('Response:', xhr.responseText);
                        alert('Failed to connect to notification service. Check console for details.');
                    }
                });
            }
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
