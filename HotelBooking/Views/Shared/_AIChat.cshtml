                    <i class="fas fa-paper-plane"></i>
                </button>
            </div>
            <div class="ai-suggestions" id="aiSuggestions">
                <button class="ai-suggestion-btn" onclick="aiChatBot.sendSuggestion('Tôi muốn đặt phòng')">
