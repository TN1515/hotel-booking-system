@model HotelBooking.Models.ViewModels.SettingsViewModel
@{
    ViewData["Title"] = "System Settings";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="mb-1">
                        <i class="fas fa-cogs text-primary me-2"></i>
                        System Settings
                    </h2>
                    <p class="text-muted mb-0">Manage hotel system configuration and settings</p>
                </div>
            </div>

            <!-- System Overview Cards -->
            <div class="row mb-4">
                <div class="col-lg-3 col-md-6 mb-3">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body text-center">
                            <div class="text-primary mb-2">
                                <i class="fas fa-users fa-2x"></i>
                            </div>
                            <h4 class="fw-bold">@Model.TotalUsers</h4>
                            <p class="text-muted mb-0">Total Users</p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 mb-3">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body text-center">
                            <div class="text-info mb-2">
                                <i class="fas fa-bed fa-2x"></i>
                            </div>
                            <h4 class="fw-bold">@Model.TotalRooms</h4>
                            <p class="text-muted mb-0">Total Rooms</p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 mb-3">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body text-center">
                            <div class="text-success mb-2">
                                <i class="fas fa-calendar-check fa-2x"></i>
                            </div>
                            <h4 class="fw-bold">@Model.TotalReservations</h4>
                            <p class="text-muted mb-0">Total Reservations</p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 mb-3">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body text-center">
                            <div class="text-warning mb-2">
                                <i class="fas fa-dollar-sign fa-2x"></i>
                            </div>
                            <h4 class="fw-bold">$@Model.TotalRevenue.ToString("N0")</h4>
                            <p class="text-muted mb-0">Total Revenue</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Settings Categories -->
            <div class="row">
                <!-- Room Types Management -->
                <div class="col-lg-6 mb-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0">
                                <i class="fas fa-home me-2"></i>Room Types Management
                            </h5>
                        </div>
                        <div class="card-body">
                            <p class="text-muted">Manage room types and their configurations</p>
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span>Active Room Types: <strong>@Model.RoomTypes.Count(rt => rt.IsActive)</strong></span>
                                <a href="@Url.Action("RoomTypes")" class="btn btn-primary btn-sm">
                                    <i class="fas fa-edit me-1"></i>Manage
                                </a>
                            </div>
                            @if (Model.RoomTypes.Any())
                            {
                                <div class="list-group list-group-flush">
                                    @foreach (var roomType in Model.RoomTypes.Take(3))
                                    {
                                        <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                                            <div>
                                                <strong>@roomType.TypeName</strong>
                                                <small class="text-muted d-block">Max: @roomType.MaxOccupancy guests</small>
                                            </div>
                                            <span class="badge bg-@(roomType.IsActive ? "success" : "secondary")">
                                                @(roomType.IsActive ? "Active" : "Inactive")
                                            </span>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Countries & States -->
                <div class="col-lg-6 mb-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-info text-white">
                            <h5 class="mb-0">
                                <i class="fas fa-globe me-2"></i>Location Management
                            </h5>
                        </div>
                        <div class="card-body">
                            <p class="text-muted">Manage countries and states for guest profiles</p>
                            <div class="row">
                                <div class="col-6">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span>Countries: <strong>@Model.Countries.Count(c => c.IsActive)</strong></span>
                                        <a href="@Url.Action("Countries")" class="btn btn-info btn-sm">
                                            <i class="fas fa-edit me-1"></i>Manage
                                        </a>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="text-center">
                                        <span>States: <strong>@Model.States.Count(s => s.IsActive)</strong></span>
                                    </div>
                                </div>
                            </div>
                            @if (Model.Countries.Any())
                            {
                                <div class="mt-3">
                                    @foreach (var country in Model.Countries.Take(3))
                                    {
                                        <div class="d-flex justify-content-between align-items-center py-1">
                                            <span>@country.CountryName</span>
                                            <small class="text-muted">@country.CountryCode</small>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Loyalty Tiers -->
                <div class="col-lg-6 mb-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-success text-white">
                            <h5 class="mb-0">
                                <i class="fas fa-star me-2"></i>Loyalty Program
                            </h5>
                        </div>
                        <div class="card-body">
                            <p class="text-muted">Manage loyalty tiers and rewards</p>
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span>Active Tiers: <strong>@Model.LoyaltyTiers.Count(lt => lt.IsActive)</strong></span>
                                <a href="@Url.Action("LoyaltyTiers")" class="btn btn-success btn-sm">
                                    <i class="fas fa-edit me-1"></i>Manage
                                </a>
                            </div>
                            @if (Model.LoyaltyTiers.Any())
                            {
                                <div class="list-group list-group-flush">
                                    @foreach (var tier in Model.LoyaltyTiers.Take(3))
                                    {
                                        <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                                            <div>
                                                <strong>@tier.TierName</strong>
                                                <small class="text-muted d-block">@tier.MinPoints - @tier.MaxPoints points</small>
                                            </div>
                                            <span class="badge bg-warning">@tier.DiscountPercentage%</span>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Services -->
                <div class="col-lg-6 mb-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-warning text-dark">
                            <h5 class="mb-0">
                                <i class="fas fa-concierge-bell me-2"></i>Hotel Services
                            </h5>
                        </div>
                        <div class="card-body">
                            <p class="text-muted">Manage additional hotel services</p>
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span>Active Services: <strong>@Model.Services.Count(s => s.IsActive)</strong></span>
                                <a href="@Url.Action("Services")" class="btn btn-warning btn-sm">
                                    <i class="fas fa-edit me-1"></i>Manage
                                </a>
                            </div>
                            @if (Model.Services.Any())
                            {
                                <div class="list-group list-group-flush">
                                    @foreach (var service in Model.Services.Take(3))
                                    {
                                        <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                                            <div>
                                                <strong>@service.ServiceName</strong>
                                                <small class="text-muted d-block">@service.Category</small>
                                            </div>
                                            <span class="badge bg-primary">Service</span>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="row">
                <div class="col-12">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-dark text-white">
                            <h5 class="mb-0">
                                <i class="fas fa-tools me-2"></i>Quick Actions
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-3 mb-2">
                                    <a href="@Url.Action("SystemInfo")" class="btn btn-outline-primary w-100">
                                        <i class="fas fa-info-circle me-2"></i>System Information
                                    </a>
                                </div>
                                <div class="col-md-3 mb-2">
                                    <a href="@Url.Action("Index", "UserManagement")" class="btn btn-outline-success w-100">
                                        <i class="fas fa-users me-2"></i>User Management
                                    </a>
                                </div>
                                <div class="col-md-3 mb-2">
                                    <a href="@Url.Action("Index", "Amenities")" class="btn btn-outline-info w-100">
                                        <i class="fas fa-spa me-2"></i>Amenities
                                    </a>
                                </div>
                                <div class="col-md-3 mb-2">
                                    <a href="@Url.Action("Index", "Report")" class="btn btn-outline-warning w-100">
                                        <i class="fas fa-chart-bar me-2"></i>Reports
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.card {
    border-radius: 12px;
    transition: transform 0.2s;
}

.card:hover {
    transform: translateY(-2px);
}

.card-header {
    border-radius: 12px 12px 0 0 !important;
}

.list-group-item {
    border: none;
    border-bottom: 1px solid #dee2e6;
}

.list-group-item:last-child {
    border-bottom: none;
}
</style>
