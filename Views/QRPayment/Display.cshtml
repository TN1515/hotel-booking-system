@model HotelBooking.Models.QRPayment
@{
    ViewData["Title"] = "QR Payment";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-qrcode me-2"></i>
                        Thanh toán QR Code VietinBank
                    </h4>
                </div>
                <div class="card-body">
                    <div class="row">
                        <!-- QR Code Section -->
                        <div class="col-md-6 text-center">
                            <div class="card border-primary mb-4">
                                <div class="card-header bg-primary text-white">
                                    <h5 class="mb-0">Quét mã QR để thanh toán</h5>
                                </div>
                                <div class="card-body">
                                    <!-- QR Code placeholder - In real implementation, use QR code library -->
                                    <div class="qr-code-container mb-3">
                                        <div id="qrcode" class="d-flex justify-content-center"></div>
                                        <div class="qr-placeholder bg-light border rounded p-4" style="min-height: 250px; display: flex; align-items: center; justify-content: center;">
                                            <div class="text-center">
                                                <i class="fas fa-qrcode fa-5x text-primary mb-3"></i>
                                                <p class="text-muted">QR Code sẽ hiển thị ở đây</p>
                                                <small class="text-muted">Sử dụng app ngân hàng để quét</small>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div class="alert alert-info">
                                        <i class="fas fa-info-circle me-2"></i>
                                        <strong>Hướng dẫn:</strong>
                                        <ol class="mb-0 mt-2">
                                            <li>Mở ứng dụng VietinBank iPay</li>
                                            <li>Chọn "Quét QR Code"</li>
                                            <li>Quét mã QR phía trên</li>
                                            <li>Xác nhận thông tin và thanh toán</li>
                                        </ol>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Payment Information -->
                        <div class="col-md-6">
                            <div class="card border-info mb-4">
                                <div class="card-header bg-info text-white">
                                    <h5 class="mb-0">Thông tin thanh toán</h5>
                                </div>
                                <div class="card-body">
                                    <table class="table table-borderless">
                                        <tr>
                                            <td><strong>Số tiền:</strong></td>
                                            <td class="text-end">
                                                <span class="badge bg-success fs-6">
                                                    @Model.Amount.ToString("C", new System.Globalization.CultureInfo("vi-VN"))
                                                </span>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td><strong>Ngân hàng:</strong></td>
                                            <td class="text-end">@Model.BankCode</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Số tài khoản:</strong></td>
                                            <td class="text-end"><code>@Model.AccountNumber</code></td>
                                        </tr>
                                        <tr>
                                            <td><strong>Tên tài khoản:</strong></td>
                                            <td class="text-end">@Model.AccountName</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Mã giao dịch:</strong></td>
                                            <td class="text-end"><code>@Model.TransactionReference</code></td>
                                        </tr>
                                        <tr>
                                            <td><strong>Nội dung:</strong></td>
                                            <td class="text-end">@Model.TransactionDescription</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Trạng thái:</strong></td>
                                            <td class="text-end">
                                                <span class="badge @(Model.Status == "Paid" ? "bg-success" : Model.Status == "Pending" ? "bg-warning" : "bg-danger")">
                                                    @(Model.Status == "Pending" ? "Chờ thanh toán" : 
                                                      Model.Status == "Paid" ? "Đã thanh toán" : 
                                                      Model.Status == "Expired" ? "Hết hạn" : "Đã hủy")
                                                </span>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>

                            <!-- Reservation Information -->
                            <div class="card border-secondary">
                                <div class="card-header bg-secondary text-white">
                                    <h6 class="mb-0">Thông tin đặt phòng</h6>
                                </div>
                                <div class="card-body">
                                    <p><strong>Khách hàng:</strong> @Model.Reservation?.User?.UserName</p>
                                    <p><strong>Phòng:</strong> @Model.Reservation?.Room?.RoomNumber</p>
                                    <p><strong>Check-in:</strong> @Model.Reservation?.CheckInDate.ToString("dd/MM/yyyy")</p>
                                    <p><strong>Check-out:</strong> @Model.Reservation?.CheckOutDate.ToString("dd/MM/yyyy")</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="row mt-4">
                        <div class="col-12">
                            <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                                <a href="@Url.Action("Details", "Reservations", new { id = Model.ReservationID })" class="btn btn-secondary me-md-2">
                                    <i class="fas fa-arrow-left me-1"></i>Quay lại đặt phòng
                                </a>
                                <button type="button" class="btn btn-info me-md-2" onclick="window.print()">
                                    <i class="fas fa-print me-1"></i>In QR Code
                                </button>
                                <button type="button" class="btn btn-success" onclick="checkPaymentStatus()">
                                    <i class="fas fa-sync-alt me-1"></i>Kiểm tra thanh toán
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Payment Status Alert -->
                    <div id="paymentStatusAlert" class="mt-3" style="display: none;"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Include QR Code library -->
    <script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.3/build/qrcode.min.js"></script>
    
    <script>
        // Generate QR Code
        document.addEventListener('DOMContentLoaded', function() {
            const qrData = '@Html.Raw(Model.QRCodeData)';
            const qrContainer = document.getElementById('qrcode');
            
            if (qrData && qrContainer) {
                // Hide placeholder
                document.querySelector('.qr-placeholder').style.display = 'none';
                
                // Generate QR code
                QRCode.toCanvas(qrContainer, qrData, {
                    width: 250,
                    height: 250,
                    margin: 2,
                    color: {
                        dark: '#000000',
                        light: '#FFFFFF'
                    }
                }, function (error) {
                    if (error) {
                        console.error('QR Code generation error:', error);
                        document.querySelector('.qr-placeholder').style.display = 'flex';
                    }
                });
            }
        });

        // Check payment status
        function checkPaymentStatus() {
            const alertDiv = document.getElementById('paymentStatusAlert');
            alertDiv.innerHTML = '<div class="alert alert-info"><i class="fas fa-spinner fa-spin me-2"></i>Đang kiểm tra trạng thái thanh toán...</div>';
            alertDiv.style.display = 'block';

            // Simulate payment check (in real implementation, call API)
            setTimeout(function() {
                const currentStatus = '@Model.Status';
                if (currentStatus === 'Pending') {
                    alertDiv.innerHTML = '<div class="alert alert-warning"><i class="fas fa-clock me-2"></i>Chưa nhận được thanh toán. Vui lòng thử lại sau.</div>';
                } else if (currentStatus === 'Paid') {
                    alertDiv.innerHTML = '<div class="alert alert-success"><i class="fas fa-check-circle me-2"></i>Thanh toán thành công!</div>';
                    setTimeout(function() {
                        window.location.href = '@Url.Action("Details", "Reservations", new { id = Model.ReservationID })';
                    }, 2000);
                }
            }, 2000);
        }

        // Auto-refresh payment status every 30 seconds
        setInterval(function() {
            if ('@Model.Status' === 'Pending') {
                // In real implementation, make AJAX call to check status
                console.log('Auto-checking payment status...');
            }
        }, 30000);
    </script>
}
